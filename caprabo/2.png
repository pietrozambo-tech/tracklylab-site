<script>
    var datas = {
        'pageType': '',
        'pageCategory': '',
        'uri': window.location.pathname,
        'pageLanguage': 'es',
        'userLoggedIn': 'false',
        'userId': 'undefined',
        'userIdMdm': 'undefined',
        'userRegisterDate': 'undefined',
        'userGender': 'undefined',
        'userAccountType': 'undefined',
        'userCapraboClubType': 'undefined',
        'userCapraboClubCard': 'undefined',
        'userStore': 'undefined',
        'userOro': 'undefined',
        'useroroType': 'undefined',
    };

    $.ajax({
        type: 'POST',
        url: '/system/modules/com.caprabo.mrmmccann.caprabocom.formatters/elements/gtm-ajax.jsp',
        data: datas,
        success: function (res) {
            
            // console.log('La respuesta es: ', res);
            $('head').prepend(res);
        },
        error: function (jqXHR, exception) {
            var msg = '';
            if (jqXHR.status === 0) {
                msg = 'Sin conexión.\n verificar red.';
            } else if (jqXHR.status === 404) {
                msg = 'Página no encontrada. [404]';
            } else if (jqXHR.status === 500) {
                msg = 'Error Interno de Servidor [500].';
            } else if (exception === 'parsererror') {
                msg = 'Error en parseo de JSON.';
            } else if (exception === 'timeout') {
                msg = 'Time out.';
            } else if (exception === 'abort') {
                msg = 'Petición Ajax abortada.';
            } else {
                msg = 'Error no categorizado.\n' + jqXHR.responseText;
            }
            console.error(msg);
        }
    });
</script><c:if test="true">
