<form id="getTicketForm" action="https://club.caprabo.com/areacliente/es/nlrLogin" method="post" class="hidden">
    <input type="hidden" id="fromApp" name="fromApp" value="caprabo_com">
    <input type="hidden" id="fromUrl" name="fromUrl" value="">
</form>

<script type="text/javascript">
    const isOnLine = 'true';
    console.log('isOnLine', isOnLine);
    let usuarioClubCapraboLogado = false;
    const fromUrl = window.location.href.split('?')[0];
    const language = 'es';

    // Si tenemos valor en el parámetro 'fromApp' no iniciamos el proceso de SSO
    
    // console.log('isEmptyFromApp', isEmptyFromApp);
    console.log('usuarioClubCapraboLogado', usuarioClubCapraboLogado);

    // Iniciamos el SSO
    $(document).ready(function () {
            try {
                // if (isEmptyFromApp) {
                    console.log('usuarioClubCapraboLogado', usuarioClubCapraboLogado);
                    if (usuarioClubCapraboLogado) {
                        userMenuFromSesion();
                    } else {
                        // setTimeout(inicioSSO, 1);
                        error();
                    }
                // } else {
                //     error();
                // }
            } catch (e) {
                console.error('Error GENERAL: ' + e);
                error();
            }
        }
    );

    function estiloNoLogado() {
        $('div#zu-zona-usuario').removeClass("zona_usuario-logado");
        $('div#zu-zona-usuario').addClass("zona_usuario-noLogado");
    }

    //
    function eventoClick() {
        // Despliega la zona de usuario en click
        $('.zu-derecha .zu-cabecera-titulo').click(function () {
            $('.zona_usuario').toggleClass('zona_activa');
        });

        $('.zu-cuerpo .zu-cuerpo-titulo').click(function () {
            $(this).parent().toggleClass('zona_activa')
        });

        $('#zu_header_boton_login').click(function (e) {
            e.preventDefault();
            $('input#fromUrl').val(window.location.href.split('?')[0]);
            $('#getTicketForm').submit();
        });
    }

    //
    function error() {
        $("#zu-error").toggleClass('hidden');
        $('#zu-loading').toggleClass('hidden');
        $('#zu-cabecera-txt').toggleClass('hidden');
        eventoClick();
        estiloNoLogado();
    }

    //
    function userMenuFromSesion() {
        console.log('userMenuFromSesion_ [/system/modules/com.caprabo.mrmmccann.caprabocom.formatters/sso/zu-header-from-sesion.jsp]');
        $.ajax({
            type: 'POST',
            url: '/system/modules/com.caprabo.mrmmccann.caprabocom.formatters/sso/zu-header-from-sesion.jsp',
            data: {language: 'es'},
            dataType: 'HTML',
            success: function (res) {
                console.log('Éxito AJAX - zu-header-from-sesion.jsp');
                //console.log(res);
                $('#zu-user-login-container').html(res);
                eventoClick();

                $('.zu-loading').toggleClass('hidden');

            },
            error: function (jqXHR, exception) {
                var msg = '';
                if (jqXHR.status === 0) {
                    msg = 'Sin conexión.\n verificar red.';
                } else if (jqXHR.status === 404) {
                    msg = 'Página no encontrada. [404]';
                } else if (jqXHR.status === 500) {
                    msg = 'Error Interno de Servidor [500].';
                } else if (exception === 'parsererror') {
                    msg = 'Error en parseo de JSON.';
                } else if (exception === 'timeout') {
                    msg = 'Time out.';
                } else if (exception === 'abort') {
                    msg = 'Petición Ajax abortada.';
                } else {
                    msg = 'Error no categorizado.\n' + jqXHR.responseText;
                }
                console.error(msg);

                $('.zu-loading').toggleClass('hidden');
            }
        });

    }

</script>
