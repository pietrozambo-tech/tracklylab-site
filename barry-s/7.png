95b0bc495d9b_BARRYS_CREECH_TREADMILL_01_131_VS_R1_C1grain-p-500.webp 500w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea31f7426a95b0bc495d9b_BARRYS_CREECH_TREADMILL_01_131_VS_R1_C1grain-p-800.webp 800w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea31f7426a95b0bc495d9b_BARRYS_CREECH_TREADMILL_01_131_VS_R1_C1grain-p-1080.webp 1080w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea31f7426a95b0bc495d9b_BARRYS_CREECH_TREADMILL_01_131_VS_R1_C1grain-p-1600.webp 1600w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea31f7426a95b0bc495d9b_BARRYS_CREECH_TREADMILL_01_131_VS_R1_C1grain-p-2000.webp 2000w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea31f7426a95b0bc495d9b_BARRYS_CREECH_TREADMILL_01_131_VS_R1_C1grain-p-2600.webp 2600w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea31f7426a95b0bc495d9b_BARRYS_CREECH_TREADMILL_01_131_VS_R1_C1grain-p-3200.webp 3200w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea31f7426a95b0bc495d9b_BARRYS_CREECH_TREADMILL_01_131_VS_R1_C1grain.webp 8145w" class="workout-card-banner-image"/></div><div class="workout-card-heading"><div class="card-heading-box"><div class="card-title-wrapper"><div class="card-title-text"><h3 class="card-title-text"><span class="card-number-list">01. </span><span class="card-title-1">Run</span></h3></div><div id="w-node-_5e177f45-ad97-e78c-d529-f99242a09033-c90661b8" class="badge-box-class"><div class="workout-badge-text">cardio</div></div><div id="w-node-_5e177f45-ad97-e78c-d529-f99242a09035-c90661b8" class="card-subheading-text">Interval Cardio</div></div></div></div><div class="workout-card-description"><div class="card-description-text">Go at your pace on top-of-the-line Woodway treadmills with instructors leading you at step. Walk, jog, run, or sprint - the class is yours.If running isn’t for you, opt for a double floor spot. You’ll spend the whole class strength training on the floor.</div></div></div></div><div role="listitem" class="workout-items w-dyn-item"><div class="work-out-card"><div class="workout-card-image"><img src="https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea320e0b5d178ed919c0ab_BARRYS_CREECH_LIFT_03_156_VS_R3_grainC1.webp" loading="lazy" title="Lift" height="Auto" alt="Lift" sizes="100vw" srcset="https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea320e0b5d178ed919c0ab_BARRYS_CREECH_LIFT_03_156_VS_R3_grainC1-p-500.webp 500w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea320e0b5d178ed919c0ab_BARRYS_CREECH_LIFT_03_156_VS_R3_grainC1-p-800.webp 800w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea320e0b5d178ed919c0ab_BARRYS_CREECH_LIFT_03_156_VS_R3_grainC1-p-1080.webp 1080w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea320e0b5d178ed919c0ab_BARRYS_CREECH_LIFT_03_156_VS_R3_grainC1-p-1600.webp 1600w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea320e0b5d178ed919c0ab_BARRYS_CREECH_LIFT_03_156_VS_R3_grainC1-p-2000.webp 2000w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea320e0b5d178ed919c0ab_BARRYS_CREECH_LIFT_03_156_VS_R3_grainC1-p-2600.webp 2600w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea320e0b5d178ed919c0ab_BARRYS_CREECH_LIFT_03_156_VS_R3_grainC1-p-3200.webp 3200w, https://cdn.prod.website-files.com/69497ece33c24736852ceba2/69ea320e0b5d178ed919c0ab_BARRYS_CREECH_LIFT_03_156_VS_R3_grainC1.webp 8192w" class="workout-card-banner-image"/></div><div class="workout-card-heading"><div class="card-heading-box"><div class="card-title-wrapper"><div class="card-title-text"><h3 class="card-title-text"><span class="card-number-list">01. </span><span class="card-title-1">Lift</span></h3></div><div id="w-node-_5e177f45-ad97-e78c-d529-f99242a09033-c90661b8" class="badge-box-class"><div class="workout-badge-text">strength</div></div><div id="w-node-_5e177f45-ad97-e78c-d529-f99242a09035-c90661b8" class="card-subheading-text">Strength Training</div></div></div></div><div class="workout-card-description"><div class="card-description-text">Build muscle consistently and effectively with weights and bodyweight moves through the expert direction of our instructors. Our weekly schedule takes you through a daily muscle focus that targets different parts of your body for a balanced training regimen.</div></div></div></div></div></div><div class="workout-card-footer"><div class="pro-tip-red-text"><strong class="protip-bold">PRO TIP: </strong></div><div class="black-text-desc">If you prefer not to run, skip the treadmill and book a double floor spot.</div></div></div></div></div><div class="page-container-2"><div class="workout-footer-card"><div class="timeline-heading-text">High energy, <br/>inclusive community</div><div class="workout-list-description"><div class="timeline timeline-mobile"><div class="timeline__item"><div class="timeline__marker"></div><div id="w-node-f155123c-678e-0926-4928-b78cb073a9ca-c90661b8" class="timeline__content"><div class="workout-desc-box"><div class="workout-list-description-heading">A Simple Format</div><div class="workout-list-description-content">You’ll rotate between treadmill and floor (or choose Double Floor). The coach guides every interval.</div></div></div></div><div class="timeline__item"><div class="timeline__marker"></div><div id="w-node-f155123c-678e-0926-4928-b78cb073a9d2-c90661b8" class="timeline__content"><div class="workout-desc-box"><div class="workout-list-description-heading">Go at your pace</div><div class="workout-list-description-content">Walk, jog, or run. Lift lighter or heavier. Options and modifications are always available.</div></div></div></div><div class="timeline__item"><div class="timeline__marker"></div><div id="w-node-f155123c-678e-0926-4928-b78cb073a9da-c90661b8" class="timeline__content"><div class="workout-desc-box"><div class="workout-list-description-heading">High energy, inclusive community</div><div class="workout-list-description-content">Once you make it to the Red Room, you have the support of an entire community to keep you motivated</div></div></div></div></div><div class="timeline-h"><div class="timeline-h__track"><div class="timeline-h__item"><div class="timeline-h__dot"></div><div id="w-node-f155123c-678e-0926-4928-b78cb073a9ec-c90661b8" class="timeline__content"><div class="workout-desc-box"><div class="workout-list-description-heading">A Simple Format</div><div class="workout-list-description-content">You’ll rotate between treadmill and floor (or choose Double Floor). The instructor guides every interval.</div></div></div></div><div id="w-node-f155123c-678e-0926-4928-b78cb073a9e2-c90661b8" class="timeline-h__item"><div class="timeline-h__dot"></div><div id="w-node-f155123c-678e-0926-4928-b78cb073a9e4-c90661b8" class="timeline__content"><div class="workout-desc-box"><div class="workout-list-description-heading">Go at your pace</div><div class="workout-list-description-content">Walk, jog, or run. Lift lighter or heavier. Options and modifications are always available.<br/></div></div></div></div><div class="timeline-h__item test-hidden"><div class="timeline-h__dot"></div><div id="w-node-f155123c-678e-0926-4928-b78cb073a9f4-c90661b8" class="timeline__content"><div class="workout-desc-box"><div class="workout-list-description-heading">High energy, <br/>Inclusive community</div><div class="workout-list-description-content">Once you make it to the Red Room, you have the support of an entire community to keep you motivated.<br/></div></div></div></div></div></div><div class="button-wrapper"><a href="/studios" data-wf-native-id-path="f155123c-678e-0926-4928-b78cb073a9fd" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="f155123c-678e-0926-4928-b78cb073a9fd" class="global-primary-button w-button">book your first class</a><a data-figma-id="3009:1588" data-wf-native-id-path="f155123c-678e-0926-4928-b78cb073a9ff" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="f155123c-678e-0926-4928-b78cb073a9ff" href="/the-workout" class="button-container ghost-button-container w-inline-block"><p data-figma-id="3009:1589" class="ghost-secondary-button-text">Learn more about the workout</p><div class="caret-icon w-embed"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
