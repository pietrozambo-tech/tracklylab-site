</div></div></div><div role="navigation" aria-label="List" class="w-pagination-wrapper"><a data-wf-native-id-path="5dfc8633-d820-09d3-dbac-68b8703f5d37:95840800-2747-93ca-645a-8283d1dc6263" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="95840800-2747-93ca-645a-8283d1dc6263" data-wf-component-context="%5B%7B%22componentId%22%3A%22c5ed6dfb-06be-56e0-51cb-2d81ff790de1%22%2C%22instanceId%22%3A%225dfc8633-d820-09d3-dbac-68b8703f5d37%22%7D%5D" href="?c9c8e959_page=2" aria-label="Next Page" class="w-pagination-next"><div class="w-inline-block">Next</div><svg class="w-pagination-next-icon" height="12px" width="12px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" transform="translate(0, 1)"><path fill="none" stroke="currentColor" fill-rule="evenodd" d="M4 2l4 4-4 4"></path></svg></a><link rel="prerender" href="?c9c8e959_page=2"/></div></div></div><div class="promo-home-apac-hidden w-embed w-script"><script>
(function () {
  'use strict';

  if (/^\/(studio|schedule|pricing)\//i.test(window.location.pathname || '')) return;

  var cfg = window.APAC_HOME_EXCLUDE_CONFIG || {};
  var REGIONS = (cfg.regions || ['singapore', 'australia']).map(lc);
  var STUDIOS = (cfg.studios || []).map(lc);

  function lc(v) {
    return String(v == null ? '' : v).trim().toLowerCase();
  }

  function isTrue(v) {
    var s = lc(v);
    return s === 'true' || s === '1' || s === 'yes';
  }

  // CMS flag (optional): push({ ..., homeHidden: "{{Hide on Homepage}}" })
  function isApacEntry(entry) {
    if (!entry) return false;
    if (isTrue(entry.homeHidden) || isTrue(entry.apacOnly)) return true;
    var region = lc(entry.promoRegionName || entry.regionName || entry.region);
    var studio = lc(entry.promoStudioName || entry.studioName);
    if (studio && STUDIOS.indexOf(studio) !== -1) return true;
    return region.split('|').some(function (part) {
      return REGIONS.indexOf(part.trim()) !== -1;
    });
  }

  function getRegions() {
    if (Array.isArray(window.seasonalPromoRegions)) return window.seasonalPromoRegions;
    try {
      if (typeof seasonalPromoRegions !== 'undefined' && Array.isArray(seasonalPromoRegions)) {
        window.seasonalPromoRegions = seasonalPromoRegions;
        return seasonalPromoRegions;
      }
    } catch (e) {}
    return null;
  }

  function filterRegions() {
    var list = getRegions();
    if (!list) return;
    var removed = [];
    for (var i = list.length - 1; i >= 0; i--) {
      if (isApacEntry(list[i])) removed.unshift(list.splice(i, 1)[0]);
    }
    if (!list.__apacHomeGuard) {
      var push = list.push;
      list.push = function () {
        var keep = Array.prototype.filter.call(arguments, function (e) {
          return !isApacEntry(e);
        });
        return push.apply(list, keep);
      };
      list.__apacHomeGuard = true;
    }
    if (removed.length) window.__apacHomeExcluded = (window.__apacHomeExcluded || []).concat(removed);
  }

  filterRegions();
  document.addEventListener('DOMContentLoaded', filterRegions);
})();
</script>
</div><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6949433bade2d703c90660e8" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6949433bade2d703c90660e8/js/barrys-641804.schunk.36b8fb49256177c8.js" type="text/javascript" integrity="sha384-4abIlA5/v7XaW1HMXKBgnUuhnjBYJ/Z9C1OSg4OhmVw9O3QeHJ/qJqFBERCDPv7G" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6949433bade2d703c90660e8/js/barrys-641804.schunk.6b485edf8059dffa.js" type="text/javascript" integrity="sha384-e/sYWL9++tXQX6lwdIfbDYugpoAcMmrGhGeBto12TbEHqAm1qsCeVQ2Jg1A64kuS" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6949433bade2d703c90660e8/js/barrys-641804.f55728cc.67113a41deb5e64e.js" type="text/javascript" integrity="sha384-S6nDKp3NasV87k799Ag+X38VLH2n6mC0IwfQx1rrh3tFk2oBIhSaHEG9I8OI8Lud" crossorigin="anonymous"></script><script data-cookieconsent="ignore">
  (function () {
    const hostname = window.location.hostname;
    // -------------------------
    // STORAGE KEYS
    // -------------------------
    const STORAGE_KEYS = {
      locationId: 'barrys_location_id',
      regionId: 'barrys_region_id',
    };

    // -------------------------
    // ENV DEFAULTS
    // -------------------------
    let appBase = '';
    let locationId = '';
    let allowedOrigin = '';
    let RETURNING_IFRAME_BASE = '';
    let regionId = '';
    let TENANT_NAME = '';
    let currentEnv = '';

    if (hostname.includes('webflow.dev.barrys.com') || hostname.includes('dev.barrys.com')) {
      currentEnv = 'dev';
      TENANT_NAME = 'barrysbootcamp.sandbox';
      appBase = 'https://app.dev.barrys.com';
      locationId = '';
      allowedOrigin = 'https://app.dev.barrys.com';

      RETURNING_IFRAME_BASE = 'https://barrysbootcamp.sandbox.marianaiframes.com';
      regionId = '';
    } else if (hostname.includes('webflow.sit.barrys.com') || hostname.includes('sit.barrys.com')) {
      currentEnv = 'sit';
      TENANT_NAME = 'barrysbootcamp.sandbox';
      appBase = 'https://app.sit.barrys.com';
      locationId = '';
      allowedOrigin = 'https://app.sit.barrys.com';
      RETURNING_IFRAME_BASE = 'https://barrysbootcamp.sandbox.marianaiframes.com';
      regionId = '';
    } else if (hostname.includes('webflow.uat.barrys.com') || hostname.includes('uat.barrys.com')) {
      currentEnv = 'uat';
      TENANT_NAME = 'barrysbootcamp';
      appBase = 'https://app.uat.barrys.com';
      locationId = '';
      allowedOrigin = 'https://app.uat.barrys.com';
      RETURNING_IFRAME_BASE = 'https://barrysbootcamp.marianaiframes.com';
      regionId = '';
    } else if (hostname === 'barrys.com' || hostname.endsWith('.barrys.com') || hostname.includes('webflow.barrys.com') || hostname.endsWith('.webflow.io')) {
      currentEnv = 'prod';
      TENANT_NAME = 'barrysbootcamp';
      appBase = 'https://app.barrys.com';
      locationId = '';
      allowedOrigin = 'https://app.barrys.com';
      RETURNING_IFRAME_BASE = 'https://barrysbootcamp.marianaiframes.com';
      regionId = '';
    } else {
      return;
    }

    function normalizeOptionalString(value) {
      return typeof value === 'string' && value.trim() ? value.trim() : '';
    }

    function syncStorageFromUrl(url) {
      try {
        var urlLocation = normalizeOptionalString(url.searchParams.get('location'));

        var urlRegion = normalizeOptionalString(url.searchParams.get('regionId'));

        if (typeof localStorage === 'undefined') return;

        if (urlLocation) {
          localStorage.setItem(STORAGE_KEYS.locationId, urlLocation);
        }

        if (urlRegion) {
          localStorage.setItem(STORAGE_KEYS.regionId, urlRegion);
        }
      } catch (e) {
        console.warn('Unable to sync storage from URL', e);
      }
    }

    // -------------------------
    // HELPERS
    // -------------------------
    function isValidValue(value) {
      return typeof value === 'string' && value.trim() !== '';
    }

    function getDatasetValue(dataset, key) {
      const value = dataset[key];
      return isValidValue(value) ? value.trim() : '';
    }

    function getEnvAwareValue(dataset, type) {
      const keyMap = {
        dev: `dev${type}`,
        sit: `sit${type}`,
        uat: `uat${type}`,
        prod: `prod${type}`,
      };

      const currentKey = keyMap[currentEnv];
      const uatKey = keyMap.uat;
      const genericKey = type.charAt(0).toLowerCase() + type.slice(1);

      const currentValue = getDatasetValue(dataset, currentKey);
      const uatValue = getDatasetValue(dataset, uatKey);
      const genericValue = getDatasetValue(dataset, genericKey);

      if (currentValue) return currentValue;
      if (uatValue) return uatValue;
      if (genericValue) return genericValue;

      return '';
    }

    function saveStudioConfigToStorage() {
      const configEl = document.getElementById('studio-config');
      if (!configEl) return;

      const cmsLocationId = getEnvAwareValue(configEl.dataset, 'LocationId');
      const cmsRegionId = getEnvAwareValue(configEl.dataset, 'RegionId');

      if (isValidValue(cmsLocationId)) {
        localStorage.setItem(STORAGE_KEYS.locationId, cmsLocationId);
        locationId = cmsLocationId;
      } else {
        localStorage.removeItem(STORAGE_KEYS.locationId);
      }

      if (isValidValue(cmsRegionId)) {
        localStorage.setItem(STORAGE_KEYS.regionId, cmsRegionId);
        regionId = cmsRegionId;
      } else {
        localStorage.removeItem(STORAGE_KEYS.regionId);
      }
    }

    function loadIdsFromStorage() {
      const storedLocationId = localStorage.getItem(STORAGE_KEYS.locationId);
      const storedRegionId = localStorage.getItem(STORAGE_KEYS.regionId);

      if (isValidValue(storedLocationId)) {
        locationId = storedLocationId.trim();
      }

      if (isValidValue(storedRegionId)) {
        regionId = storedRegionId.trim();
      }
    }

    function initStudioConfigFromCMS() {
      const configEl = document.getElementById('studio-config');
      if (!configEl) return;

      saveStudioConfigToStorage();
      loadIdsFromStorage();
    }
    function hasStoredStudioIds() {
      const storedLocationId = localStorage.getItem(STORAGE_KEYS.locationId);
      const storedRegionId = localStorage.getItem(STORAGE_KEYS.regionId);
      return isValidValue(storedLocationId);
    }

    function redirectBookingToStudiosIfNoIds() {
      const pathname = window.location.pathname || '';
      const isBookingPage = pathname === '/booking' || pathname.startsWith('/booking/');
      if (!isBookingPage) return;

      if (!hasStoredStudioIds()) {
        window.location.replace('/studios');
      }
    }

    // -------------------------
    // LOAD MARIANATEK SCRIPTS
    // -------------------------
    function loadMarianaScripts() {
      var d = document;
      var sA = ['polyfills', 'js'];

      for (var i = 0; i < sA.length; i++) {
        var s = d.createElement('script');
        s.src = 'https://' + TENANT_NAME + '.marianaiframes.com/' + sA[i];
        s.setAttribute('data-cookieconsent', 'ignore');
        s.setAttribute('data-timestamp', +new Date());
        (d.head || d.body).appendChild(s);
      }
    }

    // -------------------------
    // SET MARIANA WRAPPERS
    // -------------------------
    function getMarianaElements() {
      const bookingContainer = document.querySelector('.iframe-container-booking');
      const pricingWrapper = document.querySelector('.pricing-mariana-iframe');
      const scheduleWrapper = document.querySelector('.schedule-mariana-iframe');

      return {
        bookingContainer,
        pricingWrapper,
        scheduleWrapper,
      };
    }

    function clearMarianaIntegrations() {
      const { pricingWrapper, scheduleWrapper } = getMarianaElements();
      if (pricingWrapper) {
        pricingWrapper.removeAttribute('data-mariana-integrations');
      }
      if (scheduleWrapper) {
        scheduleWrapper.removeAttribute('data-mariana-integrations');
      }
    }

    function resetToDefaultBookingView() {
      const { bookingContainer, pricingWrapper, scheduleWrapper } = getMarianaElements();

      clearMarianaIntegrations();

      if (bookingContainer) {
        bookingContainer.style.removeProperty('display');
      }
      if (pricingWrapper) {
        pricingWrapper.style.display = 'none';
      }
      if (scheduleWrapper) {
        scheduleWrapper.style.display = 'none';
      }
    }

    function activateMarianaWrapper(sourcePath, integrationPath) {
      const { bookingContainer, pricingWrapper, scheduleWrapper } = getMarianaElements();

      if (!bookingContainer || !pricingWrapper || !scheduleWrapper) {
        return null;
      }

      clearMarianaIntegrations();

      bookingContainer.style.display = 'none';
      pricingWrapper.style.display = 'none';
      scheduleWrapper.style.display = 'none';

      if (sourcePath === '/pricing') {
        pricingWrapper.setAttribute('data-mariana-integrations', integrationPath);
        pricingWrapper.style.display = 'block';
      } else if (sourcePath === '/schedule') {
        scheduleWrapper.setAttribute('data-mariana-integrations', integrationPath);
        scheduleWrapper.style.display = 'block';
      }

      return {
        bookingContainer,
        pricingWrapper,
        scheduleWrapper,
      };
    }

    const ALLOWED_ORIGIN = allowedOrigin;

    // -------------------------
    // WIDGET DEFINITIONS
    // -------------------------
    const widgets = [
      { selector: 'iframe.flow-booking-widget', path: '/book-now' },
      { selector: 'iframe.schedule-booking-widget', path: '/schedule' },
      { selector: 'iframe.pricing-booking-widget', path: '/pricing' },
      { selector: 'iframe.studio-booking-widget', path: '/pricing' },
      { selector: 'iframe.studios-booking-widget', path: '/location-finder' },
      { selector: 'iframe.home-booking-widget', path: '/location-finder-widget' },
      { selector: 'iframe.location-search', path: '/location-search' },
      { selector: 'iframe.holiday-sale-booking-widget', path: '/holiday-pricing' },
    ];

    const noLocationParamPaths = new Set(['/location-finder', '/location-finder-widget', '/location-search', '/holiday-pricing']);
    const iframeSelectors = widgets.map((w) => w.selector);
    const IFRAME_CONTAINER_SELECTOR = '.iframe-container';
    const WRAPPER_SELECTOR = '.embedded-area-iframe';
    const BOOKING_IFRAME_SELECTOR = 'iframe.flow-booking-widget';

    // -------------------------
    // IFRAME SRC SETTER
    // -------------------------
    function setAllIframeSrc() {
      const pageUrl = new URL(window.location.href);
      const pageLocation = pageUrl.searchParams.get('location');
      // const pagePromoMock = pageUrl.searchParams.get('promoMock')
      widgets.forEach(({ selector, path }) => {
        document.querySelectorAll(selector).forEach((iframe) => {
          const url = new URL(appBase + path);

          if (!noLocationParamPaths.has(path)) {
            url.searchParams.set('location', pageLocation || locationId);
          }
          // this is for promo offer box testing
          if (currentEnv === 'sit' && path !== '/holiday-pricing') {
            url.searchParams.set('promoMock', 1);
          }

          if (path === '/location-finder') {
            const pageUrl = new URL(window.location.href);
            const q = pageUrl.searchParams.get('q');
            const lat = pageUrl.searchParams.get('lat');
            const lng = pageUrl.searchParams.get('lng');
            const pageLocationId = pageUrl.searchParams.get('locationId');
            const returningUser = pageUrl.searchParams.get('returning_user');
            if (q) url.searchParams.set('q', q);
            if (lat) url.searchParams.set('lat', lat);
            if (lng) url.searchParams.set('lng', lng);
            if (pageLocationId) url.searchParams.set('locationId', pageLocationId);
            if (returningUser) url.searchParams.set('returning_user', returningUser);
          }

          iframe.src = url.toString();
        });
      });
    }

    // -------------------------
    // SIZING HELPERS
    // -------------------------
    function getWrapper(iframe) {
      return iframe.closest(IFRAME_CONTAINER_SELECTOR) || iframe.closest(WRAPPER_SELECTOR) || iframe.parentElement;
    }

    function capToVisibleViewport(iframe, height) {
      if (!iframe.matches(BOOKING_IFRAME_SELECTOR)) return height;
      const top = iframe.getBoundingClientRect().top;
      const room = Math.round(window.innerHeight - Math.max(0, top) - 16);
      if (!Number.isFinite(room) || room < 480) return height;
      return Math.min(height, room);
    }

    function applyIframeSizing(iframe) {
      const wrapper = getWrapper(iframe);
      if (!wrapper) return;

      if (!wrapper.style.position) wrapper.style.position = 'relative';

      iframe.style.position = 'absolute';
      iframe.style.inset = '0';
      iframe.style.width = '100%';
      iframe.style.border = '0';

      const pmHeight = parseInt(iframe.dataset.pmHeight || '', 10);
      if (Number.isFinite(pmHeight) && pmHeight > 0) {
        // wrapper.style.height = pmHeight + 'px';
        // iframe.style.height = pmHeight + 'px';

        const applied = capToVisibleViewport(iframe, pmHeight);
        wrapper.style.height = `${applied}px`;
        iframe.style.height = `${applied}px`;
        return;
      }

      const h = Math.ceil(wrapper.getBoundingClientRect().height);
      iframe.style.height = h > 0 ? h + 'px' : '100%';
    }

    function resizeAll() {
      iframeSelectors.forEach((sel) => {
        document.querySelectorAll(sel).forEach(applyIframeSizing);
      });
    }

    function findIframeBySourceWindow(sourceWindow) {
      for (const sel of iframeSelectors) {
        for (const iframe of document.querySelectorAll(sel)) {
          if (iframe.contentWindow === sourceWindow) return iframe;
        }
      }

      for (const iframe of document.querySelectorAll('iframe')) {
        if (iframe.contentWindow === sourceWindow) return iframe;
      }

      return null;
    }

    // -------------------------
    // POSTMESSAGE RESIZE HANDLER
    // -------------------------
    function normalizeHeight(payload) {
      const raw = payload?.height ?? payload?.data?.height;
      const h = parseInt(raw, 10);
      return Number.isFinite(h) && h > 0 ? h : null;
    }

    function handleResize(sourceWindow, payload) {
      const h = normalizeHeight(payload);
      if (!h) return;

      const iframe = findIframeBySourceWindow(sourceWindow);
      if (!iframe) return;

      iframe.dataset.pmHeight = String(h);
      const wrapper = getWrapper(iframe);
		const applied = capToVisibleViewport(iframe, h);
      requestAnimationFrame(() => {
        iframe.style.height = `${applied}px`;
        // iframe.style.height = h + 'px';
        if (wrapper) {
          // wrapper.style.height = h + 'px';
          wrapper.style.height = `${applied}px`;
          wrapper.style.overflow = 'hidden';
        }
      });
    }

    // -------------------------
    // HASH SCROLL
    // -------------------------
    function getScrollOffset() {
      const header = document.querySelector('[data-sticky-header]') || document.querySelector('.navbar, .header, header, .w-nav');

      const headerH = header ? header.getBoundingClientRect().height : 0;
      const isMobile = window.matchMedia('(max-width: 767px)').matches;
      const extra = isMobile ? 24 : 48;
      return Math.round(headerH + extra);
    }

    function scrollToElementWithOffset(el) {
      const offset = getScrollOffset();
      const y = window.pageYOffset + el.getBoundingClientRect().top - offset;

      window.scrollTo({
        top: Math.max(0, y),
        behavior: 'smooth',
      });
    }

    function scrollToHashAdjusted() {
      const hash = window.location.hash;
      if (!hash) return;
      const target = document.querySelector(hash);
      if (!target) return;
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          scrollToElementWithOffset(target);
          const url = new URL(window.location.href);
          url.hash = '';
          history.replaceState(null, null, url.toString());
        });
      });
    }

    // -------------------------
    // URL PARAM SYNC
    // -------------------------
    function updateStepParam(step) {
      if (!Number.isFinite(step)) return;

      const url = new URL(window.location.href);
      url.searchParams.set('step', String(step));
      window.history.replaceState({}, '', url.toString());
    }

    function updateLocationParam(loc) {
      if (typeof loc !== 'string' || !loc.trim()) return;

      localStorage.setItem(STORAGE_KEYS.locationId, loc.trim());
      locationId = loc.trim();

      const url = new URL(window.location.href);
      url.searchParams.set('location', loc.trim());
      window.history.replaceState({}, '', url.toString());
    }

    const VALID_RETURNING_SOURCE_PATHS = new Set(['/pricing', '/schedule']);

    function getTodayDateString() {
      return new Date().toISOString().split('T')[0];
    }

    function normalizeOptionalString(value) {
      return typeof value === 'string' && value.trim() ? value.trim() : '';
    }

    function normalizeSourcePath(value) {
      const normalized = normalizeOptionalString(value);
      if (!normalized) return '/schedule';

      const withLeadingSlash = normalized.startsWith('/') ? normalized : '/' + normalized;

      if (VALID_RETURNING_SOURCE_PATHS.has(withLeadingSlash)) {
        return withLeadingSlash;
      }

      console.warn('[Webflow] Invalid returning sourcePath. Falling back to /schedule.', value);
      return '/schedule';
    }

    function buildActiveProduct(productId, productType) {
      const normalizedProductId = normalizeOptionalString(productId);
      if (!normalizedProductId) return '';

      const normalizedProductType = normalizeOptionalString(productType).toLowerCase();
      const prefix = normalizedProductType === 'memberships' ? 'memberships-' : 'credits-';

      return prefix + normalizedProductId;
    }

    function normalizeReturningPayload(messageData) {
      const data = messageData && typeof messageData === 'object' ? messageData : {};
      const context = data.context && typeof data.context === 'object' ? data.context : {};
      const sourcePath = normalizeSourcePath(data.sourcePath);

      return {
        sourcePath,
        location: normalizeOptionalString(context.locationId),
        region: normalizeOptionalString(context.regionId),
        activeSection: sourcePath === '/pricing' ? normalizeOptionalString(context.buyPageClientId) : '',
        activeProduct: sourcePath === '/pricing' ? normalizeOptionalString(context.activeProduct) || buildActiveProduct(context.productId, context.productType) : '',
        activeDate: sourcePath === '/schedule' ? normalizeOptionalString(context.selectedClassDate) || getTodayDateString() : '',
      };
    }

    function buildReturningPageUrl(currentUrl, payload) {
      if (!payload || !VALID_RETURNING_SOURCE_PATHS.has(payload.sourcePath)) {
        return null;
      }

      const url = new URL(currentUrl, window.location.origin);
      url.searchParams.set('flow', 'returning');
      url.searchParams.set('sourcePath', payload.sourcePath);

      if (payload.sourcePath === '/pricing') {
        if (!payload.location) {
          console.warn('[Webflow] Pricing returning flow requires a location.');
          return null;
        }

        url.searchParams.set('location', payload.location);
        url.searchParams.delete('activeProduct');
        url.searchParams.delete('activeSection');

        if (payload.activeProduct) {
          url.searchParams.set('activeProduct', payload.activeProduct);
        }

        if (payload.activeSection) {
          url.searchParams.set('activeSection', payload.activeSection);
        }

        url.searchParams.set('login', 'true');
        url.searchParams.delete('regionId');
        url.searchParams.delete('activeDate');
        return url.toString();
      }

      if (!payload.location || !payload.region) {
        console.warn('[Webflow] Schedule returning flow requires both location and regionId.');
        return null;
      }

      url.searchParams.set('location', payload.location);
      url.searchParams.set('regionId', payload.region);
      url.searchParams.set('activeDate', payload.activeDate || getTodayDateString());
      url.searchParams.delete('activeSection');
      url.searchParams.delete('activeProduct');
      url.searchParams.set('login', 'true');
      return url.toString();
    }

    function buildReturningIntegrationPath(payload) {
      if (!payload || !VALID_RETURNING_SOURCE_PATHS.has(payload.sourcePath)) {
        return null;
      }

      if (payload.sourcePath === '/pricing') {
        if (!payload.location) return null;

        const pricingParams = new URLSearchParams();
        pricingParams.set('login', 'true');

        if (payload.activeProduct) {
          pricingParams.set('activeProduct', payload.activeProduct);
        }

        if (payload.activeSection) {
          pricingParams.set('activeSection', payload.activeSection);
        }

        return `/buy/${encodeURIComponent(payload.location)}?${pricingParams.toString()}`;
      }

      if (!payload.location || !payload.region) {
        return null;
      }

      const scheduleParams = new URLSearchParams();
      scheduleParams.set('locations', payload.location);
      scheduleParams.set('login', 'true');
      scheduleParams.set('activeDate', payload.activeDate || getTodayDateString());

      return `/schedule/daily/${encodeURIComponent(payload.region)}?${scheduleParams.toString()}`;
    }

    function clearReturningFlowParamsIfNeeded() {
      const url = new URL(window.location.href);
      const flow = url.searchParams.get('flow');
      const returningKeys = ['flow', 'sourcePath', 'activeProduct', 'activeSection', 'activeDate', 'login'];

      if (flow === 'returning') return;

      let changed = false;
      returningKeys.forEach((key) => {
        if (url.searchParams.has(key)) {
          url.searchParams.delete(key);
          changed = true;
        }
      });

      if (changed) {
        window.history.replaceState({}, '', url.toString());
      }
    }

    function restoreReturningFlowIfNeeded() {
      const url = new URL(window.location.href);
      const flow = url.searchParams.get('flow');

      if (flow !== 'returning') return;

      const payload = normalizeReturningPayload({
        sourcePath: url.searchParams.get('sourcePath'),
        context: {
          locationId: url.searchParams.get('location'),
          regionId: url.searchParams.get('regionId'),
          activeProduct: url.searchParams.get('activeProduct'),
          buyPageClientId: url.searchParams.get('activeSection'),
          selectedClassDate: url.searchParams.get('activeDate'),
        },
      });

      showReturningMarianaIntegration(payload);
    }

    function showReturningMarianaIntegration(payload) {
      const resolvedPayload = {
        sourcePath: payload?.sourcePath,
        location: payload?.location || '',
        region: payload?.region || '',
        activeProduct: payload?.activeProduct || '',
        activeSection: payload?.activeSection || '',
        activeDate: payload?.activeDate || getTodayDateString(),
      };
      const integrationPath = buildReturningIntegrationPath(resolvedPayload);

      if (!integrationPath) return;

      const marianaElements = activateMarianaWrapper(resolvedPayload.sourcePath, integrationPath);
      if (!marianaElements) return;

      const normalizedUrl = buildReturningPageUrl(window.location.href, resolvedPayload);
      if (normalizedUrl) {
        window.history.replaceState({}, '', normalizedUrl);
      }
    }

    function replaceBookingIframeSrc(newSrc) {
      if (!newSrc) return;

      const iframe = document.querySelector(BOOKING_IFRAME_SELECTOR);
      if (!iframe) return;

      delete iframe.dataset.pmHeight;
      iframe.src = newSrc;
      applyIframeSizing(iframe);
    }

    function updateFlowParam(flow, sourcePath, selectedClassDate) {
      const url = new URL(window.location.href);

      if (flow) url.searchParams.set('flow', flow);
      if (sourcePath) url.searchParams.set('sourcePath', sourcePath);
      if (selectedClassDate) {
        url.searchParams.set('activeDate', selectedClassDate);
      }

      window.history.replaceState({}, '', url.toString());
    }

    // -------------------------
    // HASH LINK CLICK
    // -------------------------
    document.addEventListener('click', (e) => {
      const a = e.target.closest('a[href^="#"]');
      if (!a) return;

      const id = a.getAttribute('href');
      if (!id || id === '#') return;

      const target = document.querySelector(id);
      if (!target) return;

      e.preventDefault();
      scrollToElementWithOffset(target);
      history.replaceState(null, null, window.location.pathname + window.location.search);
    });

    // -------------------------
    // OBSERVERS
    // -------------------------
    const ro = new ResizeObserver((entries) => {
      for (const entry of entries) {
        const wrapper = entry.target;
        iframeSelectors.forEach((sel) => {
          wrapper.querySelectorAll(sel).forEach(applyIframeSizing);
        });
      }
    });

    const observeTargets = new Set();

    function attachObservers() {
      iframeSelectors.forEach((sel) => {
        document.querySelectorAll(sel).forEach((iframe) => {
          const wrapper = getWrapper(iframe);
          if (wrapper && !observeTargets.has(wrapper)) {
            observeTargets.add(wrapper);
            ro.observe(wrapper);
          }
        });
      });
    }

    const mo = new MutationObserver(() => {
      attachObservers();
      resizeAll();
    });

    // -------------------------
    // POSTMESSAGE LISTENER
    // -------------------------
    window.addEventListener('message', function (event) {
      console.log({ event });
      const allowedOrigins = new Set([ALLOWED_ORIGIN, 'https://barrysbootcamp.sandbox.marianaiframes.com', 'https://barrysbootcamp.marianaiframes.com']);

      if (!allowedOrigins.has(event.origin)) return;
      const message = event.data;
      if (!message || message.source !== 'barrys-webapp') return;

      switch (message.type) {
        case 'redirect':
          if (message.data?.newWindow) window.open(message.data.url, '_blank');
          else {
            try {
              const parsed = new URL(message.data.url, window.location.origin);
              if (parsed.pathname === '/location-finder') {
                const studiosUrl = new URL('/studios', window.location.origin);
                parsed.searchParams.forEach((v, k) => studiosUrl.searchParams.set(k, v));
                window.location.href = studiosUrl.toString();
                break;
              }
            } catch {}
            window.location.href = message.data.url;
          }
          break;

        case 'dataLayer':
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(message.data);
          break;

        case 'resize':
          handleResize(event.source, message);
          break;

        case 'bookingStart': {
          const loc = message?.data?.locationId;
          if (loc) updateLocationParam(loc);
          break;
        }

        case 'stepChange': {
          const step = Number(message?.data?.step);
          if (Number.isFinite(step)) updateStepParam(step);
          window.scrollTo({ top: 0, behavior: 'instant' });
          break;
        }

        case 'scrollToTop': {
          window.scrollTo({ top: 0, behavior: 'instant' });
          break;
        }

        case 'returningUser': {
          const payload = normalizeReturningPayload(message?.data);
          const resolvedPayload = {
            sourcePath: payload.sourcePath,
            location: payload.location,
            region: payload.region,
            activeProduct: payload.activeProduct || '',
            activeSection: payload.activeSection || '',
            activeDate: payload.activeDate || getTodayDateString(),
          };
          const nextUrl = buildReturningPageUrl(window.location.href, resolvedPayload);

          if (!nextUrl) {
            break;
          }

          if (resolvedPayload.location) {
            localStorage.setItem(STORAGE_KEYS.locationId, resolvedPayload.location);
            locationId = resolvedPayload.location;
          }

          if (resolvedPayload.region) {
            localStorage.setItem(STORAGE_KEYS.regionId, resolvedPayload.region);
            regionId = resolvedPayload.region;
          }

          window.location.href = nextUrl;
          break;
        }

        case 'bookingComplete':
          window.location.href = '/booking-confirmation';
          break;

        case 'tel':
          if (event.data?.data?.phone) {
            window.location.href = 'tel:' + event.data.data.phone;
          }
          break;

        case 'fullscreen': {
          const fsIframe = findIframeBySourceWindow(event.source);
          if (!fsIframe) break;

          const fsWrapper = getWrapper(fsIframe);
          const isFs = !!message.data?.isFullscreen;

          if (isFs) {
            fsIframe.dataset.prevStyle = fsIframe.getAttribute('style') || '';
            if (fsWrapper) {
              fsWrapper.dataset.prevStyle = fsWrapper.getAttribute('style') || '';
            }

            const vw = window.innerWidth;
            const vh = window.innerHeight;

            fsIframe.style.cssText = `position:fixed;top:0;left:0;width:${vw}px;height:${vh}px;z-index:9999;border:none;`;
            if (fsWrapper) {
              fsWrapper.style.cssText = `position:fixed;top:0;left:0;width:${vw}px;height:${vh}px;z-index:9999;overflow:visible;`;
            }

            fsIframe.contentWindow?.postMessage(
              {
                source: 'barrys-parent',
                type: 'fullscreen-viewport',
                width: vw,
                height: vh,
              },
              '*',
            );

            document.body.style.overflow = 'hidden';
          } else {
            fsIframe.setAttribute('style', fsIframe.dataset.prevStyle || '');
            delete fsIframe.dataset.prevStyle;

            if (fsWrapper) {
              fsWrapper.setAttribute('style', fsWrapper.dataset.prevStyle || '');
              delete fsWrapper.dataset.prevStyle;
            }
            document.body.style.overflow = '';
          }
          break;
        }
      }
    });
    function shouldRunScrollToHashAdjusted() {
      if (!window.location.hash) return false;
      var id = decodeURIComponent(window.location.hash.slice(1));
      if (!id) return false;
      var target;
      try {
        target = document.getElementById(id) || document.querySelector('#' + CSS.escape(id));
      } catch (e) {
        target = document.getElementById(id);
      }
      if (!target) return false;
      if (target.hasAttribute('data-no-hash-scroll')) return false;
      var blockSel = '.no-hash-scroll, [data-no-hash-scroll], .w-tab-link, .tab-link, .w-tab-pane';
      try {
        if (target.matches(blockSel) || target.closest(blockSel)) return false;
      } catch (e) {}
      if (target.classList && target.classList.length) {
        for (var i = 0; i < target.classList.length; i++) {
          var c = String(target.classList[i]).toLowerCase();
          if (c.indexOf('tab') !== -1 && c.indexOf('link') !== -1) return false;
        }
      }
      return true;
    }
    // -------------------------
    // INIT
    // -------------------------
    document.addEventListener('DOMContentLoaded', function () {
      var url = new URL(window.location.href);
      syncStorageFromUrl(url);
      redirectBookingToStudiosIfNoIds();
      initStudioConfigFromCMS();
      loadIdsFromStorage();
      loadMarianaScripts();
      resetToDefaultBookingView();
      setAllIframeSrc();
      attachObservers();
      resizeAll();
      clearReturningFlowParamsIfNeeded();
      restoreReturningFlowIfNeeded();
      window.addEventListener('resize', resizeAll);
      window.addEventListener('orientationchange', resizeAll);
      mo.observe(document.body, { childList: true, subtree: true });
      if (shouldRunScrollToHashAdjusted()) {
        scrollToHashAdjusted();
      }
    });
  })();

  (function () {
    'use strict';
    function hasStatisticsConsent() {
      return typeof window.Cookiebot !== 'undefined' && window.Cookiebot.consent && window.Cookiebot.consent.statistics === true;
    }
    function syncOptimizeTracking() {
      if (typeof window.wf === 'undefined') return;
      if (hasStatisticsConsent()) {
        window.wf.allowUserTracking({ activate: true });
      } else if (typeof window.Cookiebot !== 'undefined' && window.Cookiebot.consent && !window.Cookiebot.consent.statistics) {
        window.wf.denyUserTracking();
      }
    }
    function onReady() {
      syncOptimizeTracking();
      window.addEventListener('CookiebotOnConsentReady', syncOptimizeTracking, false);
      window.addEventListener('CookiebotOnAccept', syncOptimizeTracking, false);
      window.addEventListener(
        'CookiebotOnDecline',
        function () {
          if (typeof window.wf !== 'undefined') {
            window.wf.denyUserTracking();
          }
        },
        false,
      );
    }
    if (typeof window.wf !== 'undefined' && typeof window.wf.ready === 'function') {
      window.wf.ready(onReady);
    } else {
      window.addEventListener('load', onReady);
    }

    
  })();
</script>
 <script data-cookieconsent="ignore">
(() => {
  if (window.__barrysBookingViewport) return;
  window.__barrysBookingViewport = true;
  var SELECTORS = [
    "iframe.flow-booking-widget",
    "iframe.schedule-booking-widget",
  ];
  var MIN_HEIGHT = 320;
  var lastSent = new WeakMap();
  function iframes() {
    return SELECTORS.reduce(
      (all, selector) =>
        all.concat(Array.from(document.querySelectorAll(selector))),
      [],
    );
  }
  function targetOrigin(iframe) {
    try {
      var url = new URL(iframe.src, window.location.href);
      if (url.protocol !== "http:" && url.protocol !== "https:") return null;
      return url.origin;
    } catch (e) {
      return null;
    }
  }
  function fixedHeaderBottom() {
    var nodes = document.querySelectorAll(
      "header, .w-nav, .navbar, [class*='nav_fixed'], [class*='nav_component']",
    );
    var bottom = 0;
    for (var i = 0; i < nodes.length; i++) {
      var style = window.getComputedStyle(nodes[i]);
      if (style.position !== "fixed" && style.position !== "sticky") continue;
      var rect = nodes[i].getBoundingClientRect();
      if (rect.height > 0 && rect.bottom > bottom) bottom = rect.bottom;
    }
    return bottom;
  }
  function placeBelowHeader(iframe) {
    var wrapper = iframe.closest(".iframe-container") || iframe.parentElement;
    if (!wrapper) return 0;
    var current = parseFloat(wrapper.style.marginTop) || 0;
    var naturalTop = wrapper.getBoundingClientRect().top - current;
    var margin = Math.max(0, fixedHeaderBottom() - naturalTop);
    wrapper.style.marginTop = margin ? Math.round(margin) + "px" : "";
    return wrapper.getBoundingClientRect().top;
  }
  function slotHeight(iframe) {
    var top = placeBelowHeader(iframe);
    return Math.max(
      MIN_HEIGHT,
      Math.round(window.innerHeight - Math.max(0, top)),
    );
  }
  function sendViewport(iframe) {
    var origin = targetOrigin(iframe);
    if (!origin || !iframe.contentWindow) return;
    var height = slotHeight(iframe);
    if (lastSent.get(iframe) === height) return;
    lastSent.set(iframe, height);
    iframe.contentWindow.postMessage(
      { source: "barrys-parent", type: "viewport", height: height },
      origin,
    );
  }
  function sendAll() {
    iframes().forEach(sendViewport);
  }
  var timer = 0;
  function scheduleSend() {
    window.clearTimeout(timer);
    timer = window.setTimeout(sendAll, 100);
  }
  function onMessage(event) {
    var data = event.data;
    if (!data || data.source !== "barrys-webapp" || data.type !== "resize") {
      return;
    }
    iframes().forEach((iframe) => {
      if (iframe.contentWindow !== event.source) return;
      var origin = targetOrigin(iframe);
      if (origin && event.origin !== origin) return;
      sendViewport(iframe);
    });
  }
  function watch(iframe) {
    iframe.addEventListener("load", () => {
      lastSent.delete(iframe);
      sendViewport(iframe);
    });
  }
  function start() {
    var found = iframes();
    if (!found.length) return;
    found.forEach(watch);
    window.addEventListener("message", onMessage);
    window.addEventListener("resize", scheduleSend);
    window.addEventListener("orientationchange", scheduleSend);
    sendAll();
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
})();
</script>
