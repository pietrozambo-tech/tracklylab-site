class="js-location"></div></div><div role="listitem" class="newsletter-location-dropdown-item w-dyn-item"><div data-state="FL" data-name="Tampa" data-slug="tampa" class="js-location"></div></div></div><div role="navigation" aria-label="List" class="w-pagination-wrapper"><a data-wf-native-id-path="cf79dc39-8c4b-a03e-baef-0bc72c4cadc3:5feac359-0873-7176-a5b1-03cc732c1eb2" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="5feac359-0873-7176-a5b1-03cc732c1eb2" data-wf-component-context="%5B%7B%22componentId%22%3A%225feac359-0873-7176-a5b1-03cc732c1e98%22%2C%22instanceId%22%3A%22cf79dc39-8c4b-a03e-baef-0bc72c4cadc3%22%7D%5D" href="?4d5fe830_page=2" aria-label="Next Page" class="w-pagination-next"><div class="w-inline-block">Next</div><svg class="w-pagination-next-icon" height="12px" width="12px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" transform="translate(0, 1)"><path fill="none" stroke="currentColor" fill-rule="evenodd" d="M4 2l4 4-4 4"></path></svg></a><link rel="prerender" href="?4d5fe830_page=2"/></div></div></div><div id="w-node-_65869616-9030-20ce-492d-42f761de8ac8-732c1e98" class="newsletter-grid-item"><label for="email" class="form-text">First Time to Barry&#x27;s?<strong class="asterisk">*</strong></label><div class="form-buttons-first-time"><label data-wf-native-id-path="cf79dc39-8c4b-a03e-baef-0bc72c4cadc3:613954af-be7b-7382-30da-4c348a3050a9" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="613954af-be7b-7382-30da-4c348a3050a9" data-wf-component-context="%5B%7B%22componentId%22%3A%225feac359-0873-7176-a5b1-03cc732c1e98%22%2C%22instanceId%22%3A%22cf79dc39-8c4b-a03e-baef-0bc72c4cadc3%22%7D%5D" class="form-newsletter-button w-radio"><div class="w-form-formradioinput w-form-formradioinput--inputType-custom first-timer-radio-hidden w-radio-input"></div><input type="radio" data-name="first-timer" id="Yes" name="first-timer" required="" style="opacity:0;position:absolute;z-index:-1" value="Yes"/><span class="form-label-new