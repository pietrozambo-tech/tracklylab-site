<style>
.microsite--location::before{
content: "";
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(180deg, rgba(17, 17, 17, 0.00) 50%, #111 100%), linear-gradient(0deg, rgba(0, 0, 0, 0.50) 0%, rgba(0, 0, 0, 0.50) 100%), url() lightgray 50% / cover no-repeat;
    /* background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 1) 100%); */
    z-index: 1;
    border-radius: 8px;
}

.sub-nav-item:current { height: auto }
.workout-hero { position: relative; }

.workout-bottom-triangle{
  position: absolute;
  left: 0;
  bottom: -0.5px;
  width: 100%;
  height: 80px;
  /* gradient */
  background: linear-gradient(135deg, #000 0%, #000 50%, #000 100%);
  /* triangle shape */
  -webkit-clip-path: polygon(0 0, 50% 100%, 100% 0, 100% 100%, 0 100%);
  clip-path: polygon(0 0, 50% 100%, 100% 0, 100% 100%, 0 100%);
}


.timeline {
  position: relative;
}

.timeline__item {
  display: grid;
  grid-template-columns: 20px 1fr;
  column-gap: 12px;
  position: relative;
}

.timeline__marker {
  position: relative;
  display: flex;
  justify-content: center;
}

/* vertical line */
.timeline__marker::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 2px;
  background: #C3002F;
}

/* circle */
.timeline__marker::after {
  content: "";
  position: absolute;
  top: 6px;
  left: 50%;
  transform: translateX(-50%);
  width: 20px;
  height: 20px;
  background: #fff;
  border: 2px solid #D6001A;
  border-radius: 999px;
  z-index: 1;
}

/* cut line above first item */
.timeline__item:first-child .timeline__marker::before {
  top: 16px; /* center of circle */
}

/* cut line below last item */
.timeline__item:last-child .timeline__marker::before {
  bottom: calc(100% - 16px); /* center of circle */
}

.timeline-h__track {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  column-gap: 48px;
  position: relative;
  padding-top: 28px; /* space for dots + line */
}

/* ===== Desktop Horizontal Timeline ===== */
.timeline-h { position: relative; }

.timeline-h__track{
  /* dot sizing (keep in sync with .timeline-h__dot) */
  --dot: 20px;
  --line: 2px;

  display: grid;
  grid-template-columns: repeat(3, 1fr);
  column-gap: 48px;

  position: relative;

  /* IMPORTANT:
     padding-inline = half of dot so the line ends at dot centers */
  padding: calc(var(--dot) / 2) calc(var(--dot) / 2) 0;
}

/* line (now constrained to padded area, so it won't exceed dots) */
.timeline-h__track::before{
  content: "";
  position: absolute;
  left: calc(var(--dot) / 2);
  right: calc(var(--dot) / 2);
  top: calc(var(--dot) / 1);
  height: var(--line);
  background: #C3002F;
  border-radius: 999px;
  width: 70%;
  margin: 0 auto;
}

/* each item */
.timeline-h__item{
  text-align: center;
}

/* dot */
.timeline-h__dot{
  width: var(--dot);
  height: var(--dot);
  margin: 0 auto 12px;
  border-radius: 999px;
  background: #fff;
  border: 2px solid #D6001A;
  position: relative;
  z-index: 1; /* keep dot above the line */
}


