<!-- Braze Web SDK. Runs only after Cookiebot marketing consent. -->
<script type="text/plain" data-cookieconsent="marketing">
  (function () {
    // Cutover: add prod hostnames here (and fill in PROD_API_KEY below).

    // --- Config ---------------------------------------------------------
    var PROD_HOSTS = ['www.barrys.com', 'barrys.com'];
    var isProd = PROD_HOSTS.indexOf(location.hostname) !== -1;
    var PROD_API_KEY = '6f7dc759-fed0-4ebd-a2d5-dc0175869b94';                                    // empty = Braze disabled on prod. Fill in after non-prod testing.
    var NONPROD_API_KEY = 'bce3f106-fd44-447e-8912-7d5f2917dc83';
    var API_KEY = isProd ? PROD_API_KEY : NONPROD_API_KEY;
    var BASE_URL = 'sdk.iad-07.braze.com';
    var SDK_URL = 'https://js.appboycdn.com/web-sdk/7.1/braze.min.js';
    var POLL_INTERVAL_MS = 100;                               // how often to check for the MT localStorage entry
    var POLL_MAX_ATTEMPTS = 30;                               // 30 x 100ms = give up after 3s

    // No key for this environment: don't load the SDK at all.
    if (!API_KEY) {
      if (!isProd) console.warn('Braze: no API key configured for ' + location.hostname);
      return;
    }

    // Unverified member ID from MT's localStorage entry.
    function getMtUserId() {
      try {
        for (var i = 0; i < localStorage.length; i++) {
          var k = localStorage.key(i);
          if (/^mt\.https:\/\/barrysbootcamp(\.sandbox)?\.marianatek\.com$/.test(k)) {
            var id = JSON.parse(localStorage.getItem(k)).userId;
            if (id) return String(id);
          }
        }
      } catch (e) {}
      return null;
    }

    // --- Load and start -------------------------------------------------
    var s = document.createElement('script');
    s.src = SDK_URL;
    s.async = true;
    s.onload = function () {
      try {
        braze.enableSDK(); // clears the disableSDK cookie if present; must precede initialize

        // SDK Authentication stays disabled (no token source), so no enableSdkAuthentication option here.
        if (!braze.initialize(API_KEY, { baseUrl: BASE_URL, enableLogging: !isProd, allowUserSuppliedJavascript: true })) return;

        // Runs once the MT member ID is available (or we give up waiting).
        function start() {
          try {
            var mtId = getMtUserId();
            var brazeId = braze.getUser().getUserId();
            if (mtId && brazeId !== mtId) {
              braze.changeUser(mtId);           // logged-in member
            } else if (!mtId && brazeId) {
              braze.wipeData();                 // logged out: continue as a new anonymous user
            }

            braze.automaticallyShowInAppMessages();

            braze.openSession();
          } catch (e) {
            if (!isProd) console.warn('Braze init failed', e);
          }
        }

        // MT writes its localStorage entry after the post-login redirect, so wait briefly for it.
        var attempts = 0;
        (function wait() {
          if (getMtUserId() || ++attempts >= POLL_MAX_ATTEMPTS) return start();
          setTimeout(wait, POLL_INTERVAL_MS);
        })();
      } catch (e) {
        if (!isProd) console.warn('Braze init failed', e);
      }
    };
    document.head.appendChild(s);
  })();
</script>

<!-- Consent withdrawal. Deliberately NOT consent-gated: it must be able to run after marketing consent is removed. -->
<script>
  (function () {
    function onConsentChange() {
      var c = window.Cookiebot && window.Cookiebot.consent;
      if (c && !c.marketing && window.braze) {
        braze.wipeData();
        braze.disableSDK();
      }
    }
    window.addEventListener('CookiebotOnAccept', onConsentChange); // partial consent changes
    window.addEventListener('CookiebotOnDecline', onConsentChange);
  })();
</script>



<!-- 2b. Reload once after a fresh Allow so GTM's page-load tags fire with consent. Remove once GTM uses cookie_consent_update -->
<script data-cookieconsent="ignore">
  window.addEventListener('CookiebotOnAccept', function () {
    var cb = window.Cookiebot;
    if (!cb || !cb.changed) return;
    if (!(cb.consent.statistics || cb.consent.marketing)) return;
    try {
      var last = Number(sessionStorage.getItem('cb_consent_reload') || 0);
      if (Date.now() - last < 10000) return;
      sessionStorage.setItem('cb_consent_reload', String(Date.now()));
    } catch (e) {}
  });
</script>


<!-- 3. Market signal — reads STYXKEY_country, falls back to STYXKEY_country_referrer, then 'usa' -->
<script data-cookieconsent="ignore">
  (function () {
    function readCookie(name) {
      var m = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]+)'));
      return m ? decodeURIComponent(m[1]).toLowerCase() : '';
    }
    var country = readCookie('STYXKEY_country') || readCookie('STYXKEY_country_referrer') || 'usa';
    var ukValues = { gbr: 1, gb: 1, uk: 1, united_kingdom: 1 };
    var usValues = { usa: 1, us: 1, united_states: 1 };
    var market = ukValues[country] ? 'UK' : usValues[country] ? 'US' : 'OTHER';
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'market_resolved',
      market: market,
      country: country,
    });
  })();
</script>

<!-- 4. Google Tag Manager — tags inside wait for consent in the container -->
<script data-cookieconsent="ignore">
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, 'script', 'dataLayer', 'GTM-TRNNB7K');
</script>
<!-- End Google Tag Manager -->

