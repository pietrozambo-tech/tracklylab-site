22%3A%22cf79dc39-8c4b-a03e-baef-0bc72c4cadc3%22%7D%5D" class="link-4"><strong class="bold-text-3">Privacy Policy</strong></a></span></label></div><div id="w-node-_5feac359-0873-7176-a5b1-03cc732c1ec4-732c1e98" class="newsletter-grid-item"><input class="global-primary-button newsletter-button w-button" data-wf-component-context="%5B%7B%22componentId%22%3A%225feac359-0873-7176-a5b1-03cc732c1e98%22%2C%22instanceId%22%3A%22cf79dc39-8c4b-a03e-baef-0bc72c4cadc3%22%7D%5D" data-wf-element-id="5feac359-0873-7176-a5b1-03cc732c1ec5" aria-label="Submit" data-wait="Please wait..." type="submit" data-wf-native-id-path="cf79dc39-8c4b-a03e-baef-0bc72c4cadc3:5feac359-0873-7176-a5b1-03cc732c1ec5" data-wf-ao-click-engagement-tracking="true" value="Submit"/></div></form><div class="success-message w-form-done"><h2 class="heading-5">Thank you! Your submission has been received!</h2></div><div class="w-form-fail"><div>Oops! Something went wrong while submitting the form.</div></div></div></div><div class="newsletter-script w-embed w-script"><style>

.first-timer-radio-hidden {
  position: absolute !important;
  opacity: 0 !important;
  width: 0 !important;
  height: 0 !important;
  margin: 0 !important;
  pointer-events: none;
}

.form-newsletter-button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-sizing: border-box;
  background-color: transparent;
  border: 1px solid #111;
  border-radius: 999px;
  transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.form-newsletter-button .form-label-newsletter {
  color: #111;
  font-weight: 700;
  line-height: 100%;
  text-align: center;
  transition: color 0.15s ease;
}

.form-newsletter-button:has(input[type="radio"]:checked),
.form-newsletter-button:has(.w--redirected-checked) {
  background-color: #111;
  border-color: #111;
}

.form-newsletter-button:has(input[type="radio"]:checked) .form-label-newsletter,
.form-newsletter-button:has(.w--redirected-checked) .form-label-newsletter {
  color: #fafafa;
}

.form-newsletter-button:has(input[type="radio"]:focus-visible) {
  outline: 2px solid #111;
  outline-offset: 2px;
}

</style>
<script>
  (function () {
    var CMS_LIST_SELECTOR = '.newsletter-location-dropdown-wrapper';

    function byText(a, b) {
      return String(a).localeCompare(String(b), undefined, { sensitivity: 'base' });
    }

    function getPlaceholderColor() {
      var probe = document.createElement('input');
      probe.type = 'text';
      probe.placeholder = 'x';
      probe.style.cssText = 'position:absolute;opacity:0;pointer-events:none;height:0;width:0;';
      document.body.appendChild(probe);

      var color = getComputedStyle(probe, '::placeholder').color;
      document.body.removeChild(probe);

      return color && color !== 'rgba(0, 0, 0, 0)' ? color : 'rgba(0, 0, 0, 0.45)';
    }

    function ensurePlaceholderStyles(placeholderColor) {
      var styleId = 'region-select-placeholder-style';
      if (document.getElementById(styleId)) return;

      var style = document.createElement('style');
      style.id = styleId;
      style.textContent = '#region.is-placeholder { color: ' + placeholderColor + '; }' + '#region option, #region optgroup { color: inherit; }';
      document.head.appendChild(style);
    }

    function getListRoot(root) {
      return root.querySelector?.(CMS_LIST_SELECTOR) || root;
    }

    function parseLocation(el) {
      var state = (el.getAttribute('data-state') || 'Other').trim() || 'Other';
      var name = (el.getAttribute('data-name') || '').trim();
      var slug = (el.getAttribute('data-slug') || '').trim();
      if (!name || !slug) return null;
      return { state: state, name: name, slug: slug };
    }

    function collectFromRoot(root, seen, out) {
      getListRoot(root)
        .querySelectorAll('.js-location[data-slug][data-name]')
        .forEach(function (el) {
          var loc = parseLocation(el);
          if (!loc || seen.has(loc.slug)) return;
          seen.add(loc.slug);
          out.push(loc);
        });
    }

    function getPaginationInfo(root) {
      var listRoot = getListRoot(root);
      var links = listRoot.querySelectorAll('a[href*="_page="]');
      var pageParam = null;
      var maxPage = 1;

      links.forEach(function (link) {
        var href = link.getAttribute('href') || link.href || '';
        var match = href.match(/([a-f0-9]+)_page=(\d+)/i);
        if (!match) return;
        pageParam = match[1] + '_page';
        maxPage = Math.max(maxPage, Number(match[2]));
      });

      if (!pageParam && listRoot.querySelector('.w-pagination-next')) {
        var nextHref = listRoot.querySelector('.w-pagination-next').getAttribute('href') || '';
        var nextMatch = nextHref.match(/([a-f0-9]+)_page=(\d+)/i);
        if (nextMatch) {
          pageParam = nextMatch[1] + '_page';
          maxPage = Math.max(maxPage, Number(nextMatch[2]));
        }
      }

      return { pageParam: pageParam, maxPage: maxPage };
    }

    async function fetchAllLocations() {
      var seen = new Set();
      var all = [];

      collectFromRoot(document, seen, all);

      var pagination = getPaginationInfo(document);
      if (!pagination.pageParam || pagination.maxPage < 2) {
        return all;
      }

      var baseUrl = new URL(window.location.href);
      baseUrl.search = '';

      for (var page = 2; page <= pagination.maxPage; page++) {
        var url = new URL(baseUrl);
        url.searchParams.set(pagination.pageParam, String(page));

        var res = await fetch(url.toString(), { credentials: 'same-origin' });
        if (!res.ok) break;

        var doc = new DOMParser().parseFromString(await res.text(), 'text/html');
        var before = all.length;
        collectFromRoot(doc, seen, all);
        if (all.length === before) break;
      }

      return all;
    }

    function buildSelectOptions(sel, locations, currentName) {
      var groups = {};

      locations.forEach(function (loc) {
        if (!groups[loc.state]) groups[loc.state] = [];
        groups[loc.state].push(loc);
      });

      var states = Object.keys(groups).sort(byText);

      states.forEach(function (state) {
        var og = document.createElement('optgroup');
        og.label = state;

        groups[state]
          .sort(function (a, b) {
            return byText(a.name, b.name);
          })
          .forEach(function (city) {
            var opt = document.createElement('option');
            opt.value = city.slug;
            opt.textContent = city.name;
            og.appendChild(opt);
          });

        sel.appendChild(og);
      });

      if (currentName) {
        var match = Array.prototype.find.call(sel.querySelectorAll('optgroup > option'), function (opt) {
          return byText(opt.textContent.trim(), currentName) === 0;
        });
        if (match) sel.value = match.value;
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      var sel = document.getElementById('region');
      if (!sel) return;

      var signUpdate = document.getElementById('Sign-Up-Date');
      if (!signUpdate) return;
      signUpdate.value = new Date().toString();

      ensurePlaceholderStyles(getPlaceholderColor());

      var currentName = (document.body.getAttribute('location-name') || '').trim();

      var placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = 'Select an Option';
      placeholder.disabled = true;
      placeholder.selected = true;

      sel.innerHTML = '';
      sel.appendChild(placeholder);

      function syncPlaceholderStyle() {
        sel.classList.toggle('is-placeholder', !sel.value);
      }

      fetchAllLocations()
        .then(function (locations) {
          if (locations.length) {
            buildSelectOptions(sel, locations, currentName);
          }
          syncPlaceholderStyle();
          sel.addEventListener('change', syncPlaceholderStyle);
        })
        .catch(function () {
          syncPlaceholderStyle();
          sel.addEventListener('change', syncPlaceholderStyle);
        });
    });
  })();
</script></div></div></div></div><div class="footer-wrapper"><div class="footer-section"><div id="w-node-_99295a84-1771-df91-50ec-6bee262fab87-49348248" class="footer-grid-column"><div class="button-wrapper footer-button-wrapper"><a data-wf-native-id-path="6de1c0c1-6e33-d21f-2fe3-a530b4f4c1d1:d97ddc52-c859-6b55-a759-cc9a4f95cd9f" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="d97ddc52-c859-6b55-a759-cc9a4f95cd9f" data-wf-component-context="%5B%7B%22componentId%22%3A%22b95d55d8-000a-e03f-6ca8-00b849348248%22%2C%22instanceId%22%3A%226de1c0c1-6e33-d21f-2fe3-a530b4f4c1d1%22%7D%5D" href="/" aria-current="page" class="footer-logo-link w-inline-block w--current"><img src="https://cdn.prod.website-files.com/6949433bade2d703c90660e8/69a01416ad65e37bff26565a_Logo_white.svg" loading="lazy" alt="" class="footer-logo"/></a><a href="/my-account" aria-label="Log into my account button" data-wf-native-id-path="6de1c0c1-6e33-d21f-2fe3-a530b4f4c1d1:b30fcc08-3679-0e81-193e-789b4d2d9fc4" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="b30fcc08-3679-0e81-193e-789b4d2d9fc4" data-wf-component-context="%5B%7B%22componentId%22%3A%22b95d55d8-000a-e03f-6ca8-00b849348248%22%2C%22instanceId%22%3A%226de1c0c1-6e33-d21f-2fe3-a530b4f4c1d1%22%7D%5D" class="global-secondary-button footer-global-button">my account</a><a href="/studios" aria-label="Book your first class" data-wf-native-id-path="6de1c0c1-6e33-d21f-2fe3-a530b4f4c1d1:fc38bf8b-3740-8f51-16b9-0a901fe80f75" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="fc38bf8b-3740-8f51-16b9-0a901fe80f75" data-wf-component-context="%5B%7B%22componentId%22%3A%22b95d55d8-000a-e03f-6ca8-00b849348248%22%2C%22instanceId%22%3A%226de1c0c1-6e33-d21f-2fe3-a530b4f4c1d1%22%7D%5D" class="global-secondary-transparent footer-global-button">Book your first class</a></div></div><div id="w-node-ab2940ec-9f3b-d13e-032d-09083c3d6d9b-49348248" class="footer-grid-column menu-footer-grid"><div class="footer-terms-link"><a aria-l