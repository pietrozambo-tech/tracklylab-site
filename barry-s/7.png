<script>
   // Workout Footer Cards (Timeline)
  // Workout Number List
  document.addEventListener("DOMContentLoaded", function () {
    const items = document.querySelectorAll(".card-number-list");

    items.forEach((item, index) => {
      const number = index + 1;
      item.textContent = number < 10 ? `0${number}.` : `${number}.`;
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    const track = document.querySelector(".timeline-h__track");
    if (!track) return;

    const items = [...track.querySelectorAll(".timeline-h__item")];

    /* 1. Remove empty items */
    items.forEach(item => {
      const text = item.textContent.replace(/\s+/g, "").trim();
      if (!text) item.remove();
    });

    const dots = [...track.querySelectorAll(".timeline-h__dot")];
    if (dots.length < 2) return;

    /* 2. Trim line to first + last dot */
    const trackRect = track.getBoundingClientRect();
    const firstDot = dots[0].getBoundingClientRect();
    const lastDot  = dots[dots.length - 1].getBoundingClientRect();

    const start = firstDot.left - trackRect.left + firstDot.width / 2;
    const end   = lastDot.left  - trackRect.left + lastDot.width  / 2;

    track.style.setProperty("--line-start", `${start}px`);
    track.style.setProperty("--line-end", `${trackRect.width - end}px`);
  });


</script></body></html>