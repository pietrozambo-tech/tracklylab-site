  document.addEventListener("DOMContentLoaded", (event) => {
    window.Webflow ||= [];
  window.Webflow.push(function () {
  
    const isAndroid = /Android/i.test(navigator.userAgent);
    const isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent);
  
    const androidLink = "https://play.google.com/store/apps/details?id=com.marianatek.barrysbootcamp";
    const iosLink = "https://apps.apple.com/app/id1389503012";
  
    function updateLinks() {
      document.querySelectorAll(".app-link").forEach(link => {
        if (isAndroid) {
          link.setAttribute("href", androidLink);
        } else if (isIOS) {
          link.setAttribute("href", iosLink);
        }
      });
    }
  
    updateLinks();
  
    const observer = new MutationObserver(updateLinks);
    observer.observe(document.body, { childList: true, subtree: true });
  
  });
  });
</script></div><div class="promo_utm-link w-embed w-script"><script>
 (function () {
  'use strict';

  var LINK_SELECTORS = ['.promo-button', '.promo-banner-link'];
  var RICHTEXT_SELECTORS = ['.announcement-bar-text'];
  var RETRY_MS = 200;
  var RETRY_COUNT = 20;
  function getUtmParams() {
    var params = new URLSearchParams(window.location.search);
    var utm = new URLSearchParams();
    params.forEach(function (value, key) {
      if (key === 'utm' || key.indexOf('utm_') === 0) {
        utm.set(key, value);
      }
    });
    return utm;
  }
  function appendUtmParams(href, utmParams) {
    if (!href || !utmParams || !utmParams.toString()) {
      return href;
    }

    try {
      var url = new URL(href, window.location.origin);
      var isAbsolute = /^https?:\/\//i.test(href);

      utmParams.forEach(function (value, key) {
        if (!url.searchParams.has(key)) {
          url.searchParams.set(key, value);
        }
      });

      if (isAbsolute || url.origin !== window.location.origin) {
        return url.toString();
      }

      return url.pathname + url.search + url.hash;
    } catch (e) {
      return href;
    }
  }

  function applyUtmToLink(link, utmParams) {
    if (!link) {
      return;
    }

    var href = link.getAttribute('href');
    if (!href || href.charAt(0) === '#' || href.indexOf('javascript:') === 0) {
      return;
    }

    var next = appendUtmParams(href, utmParams);
    if (next && next !== href) {
      link.setAttribute('href', next);
    }
  }

  function collectLinks() {
    var links = [];
    var seen = [];

    function add(node) {
      if (!node || seen.indexOf(node) !== -1) {
        return;
      }
      seen.push(node);
      links.push(node);
    }

    LINK_SELECTORS.forEach(function (selector) {
      document.querySelectorAll(selector).forEach(add);
    });

    RICHTEXT_SELECTORS.forEach(function (selector) {
      document.querySelectorAll(selector).forEach(function (container) {
        container.querySelectorAll('a[href]').forEach(add);
      });
    });

    return links;
  }

  function applyUtmToSelector() {
    var utmParams = getUtmParams();
    if (!utmParams.toString()) {
      return;
    }

    collectLinks().forEach(function (link) {
      applyUtmToLink(link, utmParams);
    });
  }

  function matchesTarget(el) {
    if (!el || el.nodeType !== 1) {
      return false;
    }

    for (var i = 0; i < LINK_SELECTORS.length; i++) {
      if (el.matches(LINK_SELECTORS[i])) {
        return true;
      }
    }

    for (var j = 0; j < RICHTEXT_SELECTORS.length; j++) {
      if (el.matches(RICHTEXT_SELECTORS[j] + ' a')) {
        return true;
      }
    }

    return false;
  }

  function observeHrefChanges() {
    var utmParams = getUtmParams();
    if (!utmParams.toString() || typeof MutationObserver === 'undefined') {
      return;
    }

    var observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (mutation) {
        if (mutation.type !== 'attributes' || mutation.attributeName !== 'href') {
          return;
        }

        var link = mutation.target;
        if (matchesTarget(link)) {
          applyUtmToLink(link, utmParams);
        }
      });
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['href'],
      subtree: true,
    });
  }

  // Last resort: ensure UTMs are on the href right before navigation.
  function bindClickFallback() {
    var utmParams = getUtmParams();
    if (!utmParams.toString()) {
      return;
    }

    document.addEventListener(
      'click',
      function (event) {
        var link = event.target && event.target.closest
          ? event.target.closest('a[href]')
          : null;

        if (!link || !matchesTarget(link)) {
          return;
        }

        applyUtmToLink(link, utmParams);
      },
      true
    );
  }

  function init() {
    var utmParams = getUtmParams();
    if (!utmParams.toString()) {
      return;
    }

    applyUtmToSelector();
    observeHrefChanges();
    bindClickFallback();

    var retries = 0;
    var timer = setInterval(function () {
      applyUtmToSelector();
      retries += 1;
      if (retries >= RETRY_COUNT) {
        clearInterval(timer);
      }
    }, RETRY_MS);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

</script></div><div class="skip-promotion-emebeded-code w-embed w-script"><script>
  (function () {
  'use strict';
  var config = Object.assign(
    {
      selector: '.promo-banner-link, .promo-announcement-bar-wrappper a',
      pricingBasePath: '/pricing/',
      locationItemSelector: '.skip-promotion-location',
      flagSelector: '.skip-promotion-flag',
      slugMap: {},
      forceSkip: false,
      // Non-skip locations: add ?location=<value> to the promo link on click.
      locationParam: 'location',
      locationParamValue: 'slug', // 'slug' (e.g. denver) or 'locationId' (e.g. 9766)
      allLocationsSelector: '.promo-location-item',
    },
    window.SKIP_PROMOTION_LINK_CONFIG || {}
  );
  var LOCATION_PATH_RE = /\/(?:studio|schedule|pricing)\/([^/?#]+)/i;
  var ALLOWED_ORIGIN_RE = /^https:\/\/([a-z0-9-]+\.)*(barrys\.com|marianaiframes\.com)$/i;
  var ORIG_HREF = 'data-skip-promo-original-href';
  var ORIG_TARGET = 'data-skip-promo-original-target';

  var overrideUrl = null;
  var observer = null;
  var skipLocations = null;
  var allLocations = null;
  var pendingGeoData = null;
  var currentLocation = null; // { slug, locationId } for non-skip locations
  var state = (window.skipPromotionLink = { mode: '', active: false, slug: '', url: '', locationParam: '', locationContext: null });

  function isPresent(v) {
    if (v == null) return false;
    v = String(v).trim().toLowerCase();
    return v !== '' && v !== 'null' && v !== 'undefined' && v !== 'n/a';
  }

  function slugifyName(value) {
    return String(value || '')
      .trim()
      .toLowerCase()
      .replace(/['’]/g, '')
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
  }

  function compact(v) {
    return String(v || '').toLowerCase().replace(/[^a-z0-9]/g, '');
  }

  function buildPricingUrl(slug) {
    var base = String(config.pricingBasePath || '/pricing/');
    if (base.charAt(base.length - 1) !== '/') base += '/';
    return base + encodeURIComponent(config.slugMap[slug] || slug);
  }

  function readLocationItems(selector) {
    var list = [];
    document.querySelectorAll(selector).forEach(function (el) {
      var slug = (el.getAttribute('data-slug') || '').trim().toLowerCase();
      if (!slug) return;
      list.push({
        slug: slug,
        name: (el.getAttribute('data-name') || '').trim(),
        locationId: (el.getAttribute('data-location-id') || '').trim(),
      });
    });
    return list;
  }

  function getSkipLocations() {
    if (skipLocations) return skipLocations;
    var list = readLocationItems(config.locationItemSelector);
    if (list.length) skipLocations = list;
    return list;
  }

  function getAllLocations() {
    if (allLocations) return allLocations;
    var list = readLocationItems(config.allLocationsSelector).concat(getSkipLocations());
    if (list.length) allLocations = list;
    return list;
  }

  function findSkipLocation(ctx) {
    return findInList(getSkipLocations(), ctx);
  }

  function findInList(list, ctx) {
    if (!list.length || !ctx) return null;
    var i;
    if (ctx.locationId) {
      for (i = 0; i < list.length; i++) if (list[i].locationId && list[i].locationId === ctx.locationId) return list[i];
    }
    if (ctx.studioSlug) {
      var slug = ctx.studioSlug.toLowerCase();
      for (i = 0; i < list.length; i++) if (list[i].slug === slug) return list[i];
    }
    if (ctx.studioName) {
      var name = compact(ctx.studioName);
      for (i = 0; i < list.length; i++) if (compact(list[i].name) === name || compact(list[i].slug) === name) return list[i];
    }
    return null;
  }

  function syncLinks() {
    document.querySelectorAll(config.selector).forEach(function (link) {
      var href = link.getAttribute('href');
      if (overrideUrl) {
        if (href === overrideUrl) return;
        link.setAttribute(ORIG_HREF, href == null ? '' : href);
        if (link.getAttribute('target') === '_blank') {
          link.setAttribute(ORIG_TARGET, '_blank');
          link.removeAttribute('target');
        }
        link.setAttribute('href', overrideUrl);
        return;
      }
      if (!link.hasAttribute(ORIG_HREF)) return;
      var original = link.getAttribute(ORIG_HREF);
      link.removeAttribute(ORIG_HREF);
      if (original) link.setAttribute('href', original);
      else link.removeAttribute('href');
      if (link.getAttribute(ORIG_TARGET)) {
        link.setAttribute('target', '_blank');
        link.removeAttribute(ORIG_TARGET);
      }
    });
  }

  function setOverride(slug) {
    overrideUrl = slug ? buildPricingUrl(slug) : null;
    state.active = !!overrideUrl;
    state.slug = slug || '';
    state.url = overrideUrl || '';
    syncLinks();

    if (overrideUrl && !observer && document.body) {
      observer = new MutationObserver(function () {
        if (overrideUrl) syncLinks();
      });
      observer.observe(document.body, { subtree: true, childList: true, attributes: true, attributeFilter: ['href'] });
    }
  }

  /* Non-skip locations: ?location=<handle> on click */

  function setCurrentLocation(loc) {
    currentLocation = loc && (loc.slug || loc.locationId) ? loc : null;
    state.locationParam = getLocationParamValue() || '';
  }

  function getLocationParamValue() {
    if (!currentLocation || overrideUrl) return '';
    return config.locationParamValue === 'locationId' ? currentLocation.locationId || '' : currentLocation.slug || '';
  }

  function addLocationParam(link) {
    var value = getLocationParamValue();
    var href = link.getAttribute('href');
    if (!value || !href || /^(#|mailto:|tel:|javascript:)/i.test(href)) return;
    try {
      var url = new URL(href, window.location.href);
      if (url.searchParams.get(config.locationParam) === value) return;
      url.searchParams.set(config.locationParam, value);
      link.setAttribute('href', url.origin === window.location.origin ? url.pathname + url.search + url.hash : url.toString());
    } catch (err) {
    }
  }

  function onPromoLinkClick(event) {
    var link = event.target && event.target.closest ? event.target.closest(config.selector) : null;
    if (link) addLocationParam(link);
  }

  document.addEventListener('click', onPromoLinkClick, true);
  document.addEventListener('auxclick', onPromoLinkClick, true);

  /* Studio pages */

  function isStudioPage() {
    return LOCATION_PATH_RE.test(window.location.pathname || '') || !!(document.body && document.body.getAttribute('location-name'));
  }

  function getPageSlug() {
    var slug = (document.documentElement.getAttribute('data-wf-item-slug') || '').trim();
    if (!slug) {
      var match = (window.location.pathname || '').match(LOCATION_PATH_RE);
      slug = match ? match[1] : '';
    }
    if (!slug && document.body) slug = slugifyName(document.body.getAttribute('location-name'));
    return slug.toLowerCase();
  }

  function pageHasSkipFlag() {
    if (config.forceSkip === true) return true;
    var body = document.body;
    if (body && String(body.getAttribute('skip-promotion') || '').toLowerCase() === 'true') return true;
    var flags = document.querySelectorAll(config.flagSelector);
    for (var i = 0; i < flags.length; i++) {
      if (!flags[i].classList.contains('w-condition-invisible')) return true;
    }
    return false;
  }

  function initStudioPage() {
    state.mode = 'studio';
    var slug = getPageSlug();
    if (!slug) return;
    var body = document.body;
    var skip =
      pageHasSkipFlag() ||
      !!findSkipLocation({
        studioSlug: slug,
        studioName: (body && body.getAttribute('location-name')) || '',
        locationId: (body && body.getAttribute('location-id')) || '',
      });
    if (skip) setOverride(slug);
    else setCurrentLocation({ slug: slug, locationId: (body && body.getAttribute('location-id')) || '' });
  }
  function normalizeContext(data) {
    if (!data || typeof data !== 'object') return null;
    function pick() {
      for (var i = 0; i < arguments.length; i++) if (isPresent(arguments[i])) return String(arguments[i]).trim();
      return '';
    }
    return {
      studioName: pick(data.nearestStudioName, data.studioName, data.locationName),
      studioSlug: pick(data.studioSlug, data.slug),
      locationId: pick(data.nearestLocationId, data.locationId),
    };
  }

  function applyGeoContext(data) {
    var ctx = normalizeContext(data);
    state.locationContext = ctx;
    if (!ctx) return;
    var match = findSkipLocation(ctx);
    setOverride(match ? match.slug : null);
    if (match) {
      setCurrentLocation(null);
      return;
    }
    var loc = findInList(getAllLocations(), ctx);
    setCurrentLocation({
      slug: loc ? loc.slug : ctx.studioSlug.toLowerCase() || slugifyName(ctx.studioName),
      locationId: (loc && loc.locationId) || ctx.locationId,
    });
  }

  function onLocationMessage(event) {
    if (state.mode === 'studio') return;
    if (event.origin !== window.location.origin && !ALLOWED_ORIGIN_RE.test(event.origin || '')) return;
    var message = event.data;
    if (!message || message.source !== 'barrys-webapp' || message.type !== 'locationContext') return;
    if (document.readyState === 'loading') {
      pendingGeoData = message.data;
      return;
    }
    applyGeoContext(message.data);
  }

  function initHomepage() {
    state.mode = 'homepage';
    if (pendingGeoData) {
      applyGeoContext(pendingGeoData);
      pendingGeoData = null;
      return;
    }
    if (typeof window.seasonalPromoHomeDebug === 'function') {
      try {
        var debug = window.seasonalPromoHomeDebug();
        var ctx = debug && (debug.locationContext || debug.pendingLocationContext);
        if (ctx) applyGeoContext(ctx);
      } catch (err) {
      }
    }
  }
  if (!LOCATION_PATH_RE.test(window.location.pathname || '')) {
    window.addEventListener('message', onLocationMessage);
  }

  function init() {
    if (isStudioPage()) initStudioPage();
    else initHomepage();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();

</script></div><div class="skip-promotion w-dyn-list"><div role="list" class="w-dyn-items"><div role="listitem" class="w-dyn-item"><div data-location-id="" data-slug="athens" data-name="Athens" class="skip-promotion-location"></div></div><div role="listitem" class="w-dyn-item"><div data-location-id="10529" data-slug="popup-events" data-name="POPUP EVENTS" class="skip-promotion-location"></div></div><div role="listitem" class="w-dyn-item"><div data-location-id="6" data-slug="dubai" data-name="Dubai Marina" class="skip-promotion-location"></div></div><div role="listitem" class="w-dyn-item"><div data-location-id="1" data-slug="difc" data-name="DIFC" class="skip-promotion-location"></div></div><div role="listitem" class="w-dyn-item"><div data-location-id="64" data-slug="abu-dhabi" data-name="Abu Dhabi" class="skip-promotion-location"></div></div><div role="listitem" class="w-dyn-item"><div data-location-id="10198" data-slug="zurich" data-name="Zurich" class="skip-promotion-location"></div></div><div role="listitem" class="w-dyn-item"><div data-location-id="3" data-slug="stockholm" data-name="Stockholm" class="skip-promotion-location"></div></div><div role="listitem" class="w-dyn-item"><div data-location-id="5" data-slug="gothenburg" data-name="Gothenburg" class="skip-promotion-location"></div></div><div role="listitem" class="w-dyn-item"><div data-location-id="67" data-slug="madrid" data-name="Madrid" class="skip-promotion-location"></div></div><div role="listitem" class="w-dyn-item"><div data-location-id="66" data-slug="barcelona" data-name="Barcelona" class="skip-promotion-location"></div></div><div role="listitem" class="w-dyn-item"><div data-location-id="10500" data-slug="raffles-place" data-name="Raffles Place" class="skip-promotion-location"></div></div><div role="listitem" class="w-dyn-item"><div data-location-id="10499" data-slug="orchard" data-name="Orchard" class="skip-promotion-location"></div></div><div role="listitem" class="w-dyn-item"><div data-location-i