#review-slider .swiper-wrapper {
  align-items: stretch;
}

#review-slider .swiper-slide {
  width: 320px;
  display: flex;
}

#review-slider .swiper-slide > * {
  height: 100%;
}

#review-slider {
  overflow: visible;
}

#review-slider .swiper-pagination {
  position: relative;
  margin-top: 14px;
}

#review-slider .swiper-pagination-bullet {
  opacity: 1;
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: #d9d9d9;
  margin: 0 4px !important;
}

#review-slider .swiper-pagination-bullet-active {
  background: #d6001a;
}

.review-content-box{
  background-size: cover;
  background-position: center 35%;
  background-repeat: no-repeat;
}

.review-content-box::before{
  content: "";
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 1) 100%);
  z-index: 1;
  border-radius: 8px;
}

@media screen and (min-width: 768px){
  .swiper-button-next,
  .swiper-button-prev{
    display: none;
  }
}
</style>

<script>
const sliderEl = document.querySelector('#review-slider');
const slideCount = sliderEl ? sliderEl.querySelectorAll('.swiper-slide').length : 0;

const swiperMulti = new Swiper('#review-slider', {
  speed: 800,
  autoHeight: false,
  direction: 'horizontal',
  grabCursor: true,
  centeredSlides: false,
  slidesPerView: 'auto',
  spaceBetween: 20,
  simulateTouch: true,
  observer: true,
  observeParents: true,
  slidesOffsetBefore: 20,
  slidesOffsetAfter: 20,
  keyboard: {
    enabled: true,
    onlyInViewport: true,
    pageUpDown: true,
  },
  a11y: {
    enabled: true,
    containerMessage: 'Customer reviews carousel',
    containerRoleDescriptionMessage: 'carousel',
    itemRoleDescriptionMessage: 'slide',
    slideRole: 'listitem',
    slideLabelMessage: '{{index}} of {{slidesLength}}',
    prevSlideMessage: 'Previous reviews',
    nextSlideMessage: 'Next reviews',
    paginationBulletMessage: 'Go to review {{index}}',
  },
  pagination: {
    el: '.swiper-pagination',
    clickable: true,
  },
  navigation: {
    nextEl: '.swiper-button-next',
    prevEl: '.swiper-button-prev',
  },
  breakpoints: {
    768: {
      slidesPerView: 3,
      spaceBetween: 20,
      slidesOffsetBefore: 0,
      slidesOffsetAfter: 0,
      allowTouchMove: slideCount > 3,
    },
  },
  on: {
    init(swiper) {
      const wrapper = swiper.el.querySelector('.swiper-wrapper');
      if (wrapper) wrapper.setAttribute('role', 'list');

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) swiper.params.speed = 0;

      const nextBtn = document.querySelector('.swiper-button-next');
      const prevBtn = document.querySelector('.swiper-button-prev');

      if (nextBtn) {
        nextBtn.setAttribute('type', 'button');
        nextBtn.setAttribute('aria-label', 'Next reviews');
      }

      if (prevBtn) {
        prevBtn.setAttribute('type', 'button');
        prevBtn.setAttribute('aria-label', 'Previous reviews');
      }

      updateDesktopControls(swiper);
    },
    resize(swiper) {
      updateDesktopControls(swiper);
    },
    observerUpdate(swiper) {
      updateDesktopControls(swiper);
    }
  }
});

function updateDesktopControls(swiper) {
  const isDesktop = window.innerWidth >= 768;
  const showControls = slideCount > 3;

  const pagEl = document.querySelector('.swiper-pagination');
  const nextEl = document.querySelector('.swiper-button-next');
  const prevEl = document.querySelector('.swiper-button-prev');

  if (!isDesktop) {
    if (pagEl) pagEl.style.display = '';
    if (nextEl) nextEl.style.display = 'none';
    if (prevEl) prevEl.style.display = 'none';
    return;
  }
  if (pagEl) pagEl.style.display = showControls ? '' : 'none';
  if (nextEl) nextEl.style.display = 'none';
  if (prevEl) prevEl.style.display = 'none';
  swiper.allowTouchMove = showControls;
  if (!showControls) swiper.slideTo(0, 0);
}
</script></div></div></div><div class="page-container-2"><div class="join-the--hussle"><h2 class="first-class-section-title">Join the hustle</h2><a href="/studios" data-wf-native-id-path="afcdbf2c-c6f4-f7f4-03d1-9ad78585dfac" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="afcdbf2c-c6f4-f7f4-03d1-9ad78585dfac" class="global-primary-button join-the-hustle-button w-button">book your first class</a></div></div></main><div class="newsletter-section"><div class="page-large-container"><div class="newsletter-heading"><h3 class="newsletter-section-heading">newsletter form signup</h3></div><div class="newsletter-grid"><div><div class="news-letter-form-container w-form"><form id="wf-form-Newsletter" name="wf-form-Newsletter" data-name="Newsletter" method="get" class="newsletter-form-wrapper" data-wf-page-id="6949433eade2d703c90661b8" data-wf-element-id="5feac359-0873-7176-a5b1-03cc732c1e9f"><div id="w-node-bcfaae6e-b4d8-2bc4-4223-b2de74fea696-732c1e98" class="newsletter-grid-item hidden-field"><input class="newsletter-form-field hidden-form-field w-input" maxlength="256" name="Sign-Up-Date" data-name="Sign Up Date" placeholder="" type="text" id="Sign-Up-Date" required=""/></div><div id="w-node-e9c65b3e-dac9-6bb0-5649-4d9e2133ade0-732c1e98" class="newsletter-grid-item"><label for="First-Name" class="form-text">First Name<strong class="asterisk">*</strong></label><input class="newsletter-form-field w-input" maxlength="256" name="First-Name" data-name="First Name" placeholder="Type here" type="text" id="First-Name" required=""/></div><div id="w-node-e33831c1-ab34-e251-e2d7-24ed723f1bc3-732c1e98" class="newsletter-grid-item"><label for="Last-Name" class="form-text">Last Name<strong class="asterisk">*</strong></label><input class="newsletter-form-field w-input" maxlength="256" name="Last-Name" data-name="Last Name" placeholder="Type here" type="text" id="Last-Name" required=""/></div><div id="w-node-_5feac359-0873-7176-a5b1-03cc732c1eb6-732c1e98" class="newsletter-