<!-- 6. Barry's auth state — POC (Home branch only) -->
<script>
  (function () {
    var AUTH_BASE = 'https://auth.barrys.com';
    var html = document.documentElement;
    html.classList.add('barrys-state-loading');
    fetch(AUTH_BASE + '/me', { credentials: 'include', cache: 'no-store' })
      .then(function (r) {
        return r.ok ? r.json() : null;
      })
      .then(function (user) {
        html.classList.remove('barrys-state-loading');
        if (user) {
          html.classList.add('barrys-logged-in');
          if (typeof user.classes_completed === 'number' && user.classes_completed > 0) {
            html.classList.add('barrys-has-classes');
          } else {
            html.classList.add('barrys-no-classes');
          }
        } else {
          html.classList.add('barrys-logged-out');
        }
      })
      .catch(function () {
        html.classList.remove('barrys-state-loading');
        html.classList.add('barrys-logged-out');
      });
  })();
</script>
<style>
  /* Barry's auth-state visibility (POC) */
  .barrys-state-loading [data-barrys-show] {
    visibility: hidden !important;
  }
  [data-barrys-show] {
    display: none !important;
  }
  .barrys-logged-out [data-barrys-show='logged-out'] {
    display: inline-flex !important;
  }
  .barrys-logged-in [data-barrys-show='logged-in'] {
    display: inline-flex !important;
  }
  .barrys-logged-in.barrys-has-classes [data-barrys-show='has-classes'] {
    display: inline-flex !important;
  }
  .barrys-logged-in.barrys-no-classes [data-barrys-show='no-classes'] {
    display: inline-flex !important;
  }
</style>
