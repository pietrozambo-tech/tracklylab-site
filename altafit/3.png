<style>
.find_gym {
    position: absolute;
    top: -10px;
    left: -434px;
    width: 940px;
    min-height: 150px;
    background-color: #343546;
    background-image: url(https://altafitgymclub.com/imagenes/fondo-menu-franquiciados.png);
    background-repeat: no-repeat;
    background-position: center center;
    background-size: 709px 399px;
    z-index: 9999;
    font-size: 15px;
    color: #fff;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 5px 3px 16px -4px rgba(0, 0, 0, 0.55);
    -webkit-box-shadow: 5px 3px 16px -4px rgba(0, 0, 0, 0.55);
    -moz-box-shadow: 5px 3px 16px -4px rgba(0,0,0,0.55);
}



/* Flecha siempre centrada arriba */
.arrow {
    position: absolute;
    top: -25px;
    left: 484px;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 40px solid transparent;
    border-right: 40px solid transparent;
    border-bottom: 25px solid #343546;
    z-index: 10;
}

/* Grid de 3 columnas */
.regions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    align-items: start; /* no se estira verticalmente */
}

.region-block {
    /*background: #313246;*/
    padding: 10px;
    border-radius: 5px;
    display: flex;
    flex-direction: column;
}

.region-title {
    color: #fff;
    font-size: 18px;
    border-bottom: 1px #e1523d solid;
    padding-bottom: 5px;
    margin-bottom: 10px;
	text-transform: uppercase;
    line-height: 16px;
    font-family: 'avenirnextcyr-heavy';
}

.club-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
	line-height: 28px;
    text-transform: capitalize;
}

.club-list li {
    margin-bottom: 3px;
}

.club-list li a {
    color: #fff;
    text-decoration: none;
    font-size: 16px;
}

.club-list li a:hover {
    color: #e1523d;
