 x1="4" x2="20" y1="18" y2="18"></line></svg></div></button><button class="items-center justify-center gap-2 whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:bg-accent hover:text-accent-foreground py-2 hidden sm:flex h-11 lg:h-12 px-3 lg:px-4 rounded-[12px] shadow-[0_2px_8px_rgba(41,4,2,0.08)]" style="background-color:var(--ds-surface-base);color:var(--ds-action-secondary-text)" data-testid="button-accedi"><span class="[font-family:&#x27;Inter&#x27;,Helvetica] font-semibold text-xs lg:text-sm xl:text-[14px] tracking-[0] leading-[20px]">Accedi</span></button><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:bg-accent hover:text-accent-foreground py-2 h-11 lg:h-12 px-3 lg:px-4 rounded-[12px] transition-colors duration-300 shadow-[0_2px_8px_rgba(41,4,2,0.08)]" type="button" style="background-color:var(--ds-satispay-500);color:var(--ds-off-white)" data-testid="button-iscriviti"><span class="[font-family:&#x27;Inter&#x27;,Helvetica] font-semibold text-xs lg:text-sm xl:text-[14px] tracking-[0] leading-[20px]"><span>Iscriviti</span></span></button></div></div></div></div><!--astro:end--></astro-island><astro-island uid="Z1cXOXM" prefix="r6" component-url="/_astro/WelfareActionBar.oSGrtwYd.js" component-export="WelfareActionBar" renderer-url="/_astro/client.B-Ov0gnE.js" props="{&quot;initialVisible&quot;:[0,false],&quot;initialSection&quot;:[0,&quot;welfare&quot;],&quot;initialPath&quot;:[0,&quot;/404&quot;],&quot;data-astro-transition-persist&quot;:[0,&quot;welfare-action-bar&quot;]}" ssr client="load" opts="{&quot;name&quot;:&quot;WelfareActionBar&quot;,&quot;value&quot;:true}" data-astro-transition-persist="welfare-action-bar"></astro-island><astro-island uid="XutRS" prefix="r7" component-url="/_astro/AppDownloadQRBadge.DYlr5P6_.js" component-export="AppDownloadQRBadge" renderer-url="/_astro/client.B-Ov0gnE.js" props="{&quot;initialVisible&quot;:[0,false],&quot;initialDraft&quot;:[0,false],&quot;initialPromoPath&quot;:[0],&quot;data-astro-transition-persist&quot;:[0,&quot;app-download-qr-badge&quot;]}" ssr client="load" opts="{&quot;name&quot;:&quot;AppDownloadQRBadge&quot;,&quot;value&quot;:true}" data-astro-transition-persist="app-download-qr-badge" await-children><div class="hidden lg:block fixed bottom-12 z-[150] right-12 xl:right-[85px]" style="view-transition-name:persistent-qr-badge;display:none" aria-hidden="true" data-testid="app-download-qr-badge"><div class="flex items-center gap-[18px] rounded-[24px] shadow-[0_8px_24px_rgba(41,4,2,0.15)] ring-1 ring-black/5 p-3" style="background-color:var(--ds-navbar-grey);padding-right:24px"><div class="rounded-[10px] flex-shrink-0"><img src="https://www.datocms-assets.com/133951/1737978066-qr_code_svg_giftcard_mainpage.svg" alt="QR code per scaricare l&#x27;app Satispay" class="w-[102px] h-[102px] block" data-testid="img-app-download-qr"/></div><div class="overflow-hidden" style="width:auto;opacity:1"><p class="font-[&#x27;Inter&#x27;] text-[20px] leading-[1.3] text-[#290402] whitespace-nowrap pr-1.5" data-testid="text-app-download-copy">Scarica l&#x27;app<br/>e ottieni<!-- --> <span class="font-semibold text-[#ff3d00]">5€</span></p></div></div></div><!--astro:end--></astro-island><div data-astro-transition-scope="astro-nfpogox7-1"><div class="min-h-screen flex flex-col lg:flex-row"><!-- Left: image + lilac block with scalloped divider --><div class="w-full lg:w-1/2 flex flex-col"><div class="relative flex-1 min-h-[320px] lg:min-h-0"><img src="/404_image.webp" alt="Errore 404" class="absolute inset-0 w-full h-full object-cover object-top"></div><div class="relative bg-[#C8BFF5] px-6 sm:px-10 pb-14 pt-12 text-center"><div class="absolute -top-[14px] left-0 right-0 h-[15px] bg-[#C8BFF5]" style="mask-image: radial-gradient(circle 15px at 15px 0, transparent 14px, black 15px); -webkit-mask-image: radial-gradient(circle 15px at 15px 0, transparent 14px, black 15px); mask-size: 30px 15px; -webkit-mask-size: 30px 15px; mask-repeat: repeat-x; -webkit-mask-repeat: repeat-x;"></div><p class="font-['Inter'] font-bold uppercase tracking-[1px] text-[#ff3d00] text-sm mb-4">Error 404</p><h1 class="font-['Bricolage_Grotesque'] font-extrabold text-[#290402] text-[32px] sm:text-[40px] lg:text-[46px] leading-[1.1] tracking-[-1px] max-w-[640px] mx-auto">La faccia di chi non trova la pagina che stava cercando.</h1></div></div><!-- Right: links --><div class="w-full lg:w-1/2 bg-[#fffbef] flex items-start lg:items-center px-6 sm:px-10 lg:px-20 py-14 lg:py-0"><div class="max-w-[560px]"><div><h2 class="font-['Inter'] font-bold text-[#290402] text-lg">Riparti da qui</h2><p class="font-['Inter'] text-[#290402] text-base mt-2">È il più classico dei suggerimenti. Ma funziona sempre.</p><a href="/it-it/privati" class="mt-4 inline-flex items-center gap-2 font-['Inter'] font-semibold text-[#290402] hover:opacity-70 transition-opacity" data-testid="link-404-home">Torna in home<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div><a href="https://satispaysupport.zendesk.com/hc/it" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 font-['Inter'] font-semibold text-[#290402] hover:opacity-70 transition-opacity" data-testid="link-404-assistenza">Assistenza<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div></div></div><script>
    // Cookiebot injects its banner + floating widget into <body> at runtime.
    // View Transitions swap the whole body, so those injected nodes would be
    // lost on navigation. Carry them over into the incoming document.
    if (window.__cookiebotSwapHandler) {
      document.removeEventListener('astro:before-swap', window.__cookiebotSwapHandler);
    }
    window.__cookiebotSwapHandler = function(event) {
      if (!event.newDocument) return;
      var selectors = '#CookiebotWidget, [id^="CybotCookiebot"], [id^="CookiebotWidget"]';
      // Body nodes (banner + floating widget) AND head nodes (Cookiebot-injected
      // styles/scripts) must both be carried over: the head is swapped too, so
      // transported body nodes would otherwise render unstyled/invisible.
      document.head.querySelectorAll(selectors).forEach(function(el) {
        if (!event.newDocument.getElementById(el.id)) {
          event.newDocument.head.appendChild(el);
        }
      });
      document.body.querySelectorAll(selectors).forEach(function(el) {
        if (!event.newDocument.getElementById(el.id)) {
          event.newDocument.body.appendChild(el);
        }
      });
    };
    document.addEventListener('astro:before-swap', window.__cookiebotSwapHandler);

    if (window.__bannerSwapHandler) {
      document.removeEventListener('astro:after-swap', window.__bannerSwapHandler);
    }
    window.__bannerSwapHandler = function() {
      var show = document.body.dataset.showBanner === 'true';
      var isDesktop = window.matchMedia('(min-width: 768px)').matches;
      var bannerWrap = document.querySelector('[data-promo-banner]');
      if (!bannerWrap) return;
      if (show && isDesktop) {
        bannerWrap.classList.remove('!hidden');
        requestAnimationFrame(function() {
          var inner = bannerWrap.querySelector('[data-testid="banner-promo"]');
          if (inner) {
            document.documentElement.style.setProperty('--promo-banner-height', inner.offsetHeight + 'px');
          }
        });
      } else {
        if (!show) bannerWrap.classList.add('!hidden');
        document.documentElement.style.setProperty('--promo-banner-height', '0px');
      }
    };
    document.addEventListener('astro:after-swap', window.__bannerSwapHandler);

    if (!window.__bannerResizeHandler) {
      window.__bannerResizeHandler = function() {
        var show = document.body.dataset.showBanner === 'true';
        if (!show) return;
        var isDesktop = window.matchMedia('(min-width: 768px)').matches;
        if (!isDesktop) {
          document.documentElement.style.setProperty('--promo-banner-height', '0px');
        } else {
          var inner = document.querySelector('[data-testid="banner-promo"]');
          if (inner) {
            document.documentElement.style.setProperty('--promo-banner-height', inner.offsetHeight + 'px');
          }
        }
      };
      window.addEventListener('resize', window.__bannerResizeHandler);
    }

    if (!window.__spaceScrollBlocker) {
      window.__spaceScrollBlocker = function(e) {
        if (e.code !== 'Space' && e.key !== ' ') return;
        var t = e.target;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.tagName === 'BUTTON' || t.tagName === 'SUMMARY' || t.isContentEditable)) return;
        e.preventDefault();
      };
      window.addEventListener('keydown', window.__spaceScrollBlocker);
    }
  </script></body></html>