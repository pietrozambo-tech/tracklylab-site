  // Keep Astro's loader intact: besides fetching HTML it validates the
  // destination and prepares its styles. Once that work is complete, decode
  // the only above-the-fold homepage image while the old page is still live.
  // A short timeout and the navigation AbortSignal ensure a slow asset never
  // makes navigation feel stuck. Videos are deliberately not preloaded here.
  if (window.__criticalHeroPreparationHandler) {
    document.removeEventListener('astro:before-preparation', window.__criticalHeroPreparationHandler);
  }
  window.__criticalHeroPreparationHandler = function(event) {
    var defaultLoader = event.loader;
    event.loader = async function() {
      var requestedHomepage = /^\/(?:it-it|en-it|fr-fr|fr-lu|en-lu)\/(?:privati|welfare|business)\/?$/.test(
        event.to.pathname
      );
      await defaultLoader();
      if (event.defaultPrevented) {
        // Astro normally turns a failed client-side fetch into a hard
        // navigation to the failed destination. For the three homepage tabs
        // that can replace a useful page with the browser's blank network
        // error document. Redirect that native fallback to the still-current
        // URL instead. An aborted request belongs to a newer navigation and
        // Astro already ignores it, so never interfere with that race.
        if (requestedHomepage && !event.signal.aborted) {
