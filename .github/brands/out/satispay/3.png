      var source = criticalImage.getAttribute('src');
      if (!source) return;
      await new Promise(function(resolve) {
        var settled = false;
        var image = new Image();
        var timeoutId;
        var finish = function() {
          if (settled) return;
          settled = true;
          clearTimeout(timeoutId);
          event.signal.removeEventListener('abort', finish);
