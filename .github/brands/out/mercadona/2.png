<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">

    <link rel="manifest" href="/manifest.json">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="canonical" href="https://www.mercadona.es/"/>

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="theme-color" content="#000000">
    <meta name="google" content="notranslate">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@Mercadona">
    <meta name="twitter:creator" content="@Mercadona">
    <meta property="og:url" content="https://mercadona.es">
    <meta property="og:title" content="Mercadona">
    <meta property="og:description" content="Empieza tu compra online en Mercadona, encuentra nuestros supermercados más cercanos o descubre cómo trabajar con nosotros">
    <meta property="og:image" content="https://mercadona.es/web-display-img.png">

    <title>Mercadona</title>
    <meta name="description" content="Empieza tu compra online en Mercadona, encuentra nuestros supermercados más cercanos o descubre cómo trabajar con nosotros">

    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-119340431-1"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>

    <script>
      if (window.location.pathname === '/verify-email') {
        document.documentElement.classList.add('no-layout');
      }
    </script>
    <style>.no-layout .o-navbar-fluid,.no-layout .o-footer,.no-layout .o-footer-fluid{display:none}</style>
    <script type="module" crossorigin src="/static/js/main.54fdfe7c.js"></script>
    <link rel="stylesheet" crossorigin href="/static/css/main.8d6524c9.css">
  </head>
  <body>
    <div class="o-navbar-fluid">
      <div id="foodstuff"></div>
      <nav class="o-navbar">
        <div class="o-menu__wrapper">
          <div class="o-logo"></div>
          <span class="o-language" i18n="languages_select_mobile_resolution"></span>
          <i class="o-menu__icon icon ic-hamburger-28"></i>
        </div>
        <ul class="o-menu"></ul>
        <div class="o-lang-selector"></div>
      </nav>
    </div>
    <div id="root"></div>
    <section class="o-footer"></section>
    <section class="o-footer-fluid">
      <footer class="o-footer">
        <p class="o-copyright" i18n="footer_section.copyright"></p>
        <ul class="o-legal"></ul>
      </footer>
    </section>
  </body>
</html>
