CallPage"],"allowPurchase":"Yes","id":"2349","promoOfferLine1":"Promo Price for 9 Months","promoOfferLine2":"Get Immediate Activation with eSIM","promoOfferLine3":null,"promoOfferLine4":null,"dataAllowance":"Unlimited","dataAllowanceUnit":" ","dataAllowanceDuration":null,"atntDataAllowence":null,"atntDataAllowanceUnit":null,"bonusDataAllowance":null,"bonusDataAllowanceUnit":null,"bonusDataAllowanceDuration":null,"seoIndex":"Index","seoFollow":"Follow","scriptTag":"\n{\n  \"@context\": \"https://schema.org/\", \n  \"@type\": \"Product\", \n  \"name\": \"Unlimited Plus $18/30 Days Plan\",\n  \"image\": \"https://pim-assets.ldsvcplatform.com/_default_upload_bucket/simusa_2.png\",\n  \"description\": \"Get Unlimited Talk, Text \u0026 Data for $18/30 days. Includes 10GB High-Speed Hotspot, Intl. Minutes to 100 Countries \u0026 Immediate eSIM Activation. Data slows after 40GB.\",\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"name\": \"Lyca Mobile US\"\n  },\n  \"offers\": {\n    \"@type\": \"Offer\",\n    \"url\": \"https://www.lycamobile.us/en/plan/50-high-data-plan/\",\n    \"priceCurrency\": \"USD\",\n    \"price\": \"18\",\n    \"availability\": \"https://schema.org/InStock\",\n    \"itemCondition\": \"https://schema.org/NewCondition\"\n  },\n  \"aggregateRating\": {\n    \"@type\": \"AggregateRating\",\n    \"ratingValue\": \"4.5\",\n    \"bestRating\": \"5\",\n    \"worstRating\": \"3.6\",\n    \"ratingCount\": \"111\"\n  }\n}\n","boltOnType":null,"contractVisibility":null,"contractText":null,"captchaFlag":true,"familyPlanDetails":null,"familyPlanFeatures":"","familyPlanAvailable":null,"familyPlanImage":{"metadata":null,"fullpath":"/_default_upload_bucket/Family_icon_01_2.png","id":"1512"},"customerType":[{"customerTypeCode":"ca","customerType":"New Customer"}],"bundleGroupDetails":[{"buddyBundleCode":null,"buddyBundlePrice":null,"buddyBundleAllowance":null,"buddyBundleName":null,"buddyOfferText":null,"buddyBundleHeading":null,"offeringId":null,"addonType":null,"recommendedPlans":null,"addonBundles":null,"bundleCode":"8055","existingCustomerBundleCode":null,"productValidity":30,"basePrice":49,"promotionalPricing":18,"promotionalPricingDuration":30,"productValidityUnit":"days","promotionalPricingDurationUnit":"days","promotionalText":null,"offerPricingBrief":null,"monthlyPricing":null,"monthlyPricingUnit":null,"longTermPlanProductValidity":null}],"longDescription":"\u003cul class=\"plan-details-list\"\u003e\u003cli\u003e\u003cspan class=\"pdata\"\u003eUnlimited Talk \u0026amp; Text\u003c/span\u003e\u003c/li\u003e\u003cli\u003eEnjoy unlimited data with full-speed access for the first 50GB!\u003c/li\u003e\u003cli\u003e\u003cspan class=\"pdata\"\u003eIncludes 15GB of High-Speed Hotspot Data\u003c/span\u003e\u003cbr /\u003e\u003c/li\u003e\u003cli\u003e\u003cspan class=\"pdata\"\u003eUnlimited International Minutes and Texts to 100 Countries\u003c/span\u003e\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003e$10 International Roaming Credit\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003eUnlimited Talk and Text in Mexico and Canada (5GB Roaming Data)\u003c/li\u003e\u003c/ul\u003e","shortDescription":"\u003cul\u003e\u003cli\u003e\u003cspan class=\"pdata\"\u003eUnlimited Talk \u0026amp; Text\u003c/span\u003e\u003c/li\u003e\u003cli\u003eEnjoy unlimited data with full-speed access for the first 50GB!\u003c/li\u003e\u003cli\u003e\u003cspan class=\"pdata\"\u003eUnlimited International Minutes and Texts to 100 Countries\u003c/span\u003e\u003cbr /\u003e\u003c/li\u003e\u003c/ul\u003e","dialCode":null,"textShortCode":null,"allowRenew":"No","autoRenew":"Yes","productTermsAndCondition":"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\"font-size: 11.0pt; font-family: \u0026#039;Calibri\u0026#039;,sans-serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-IN; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;\"\u003e\u003ca href=\"https://cms-assets.ldsvcplatform.com/USA/s3fs-public/2026-06/Unlimited%20Plus%2030%20Days%20_CA.pdf-1.pdf?VersionId\u0026#61;DKhRt0ds77M1psWKJe7ut9wEnWPNmgVc\" target=\"_blank\"\u003eBroadband Facts\u003c/a\u003e\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cbr /\u003e\u003c/p\u003e\u003cp\u003e Offer available on new lines of service purchased at Lycamobile.com only. ENROLLMENT IN AUTO-RENEWAL REQUIRED to obtain discounted offer price. Discounted price available for initial 30-day plan and the number of renewals indicated, contingent on continued enrolment in auto-renewal (if auto-renewal is disabled or fails, discounted offer price will no longer apply for subsequent plan purchases).\u003c/p\u003e\u003cp\u003e\u003cbr /\u003e\u003c/p\u003e\u003cp\u003e*Unlimited International calls are to first 10 dialled numbers per country. Plan does not include unlimited calls to Morocco IAM and Wana destinations or calls to Israel numbers with prefix 97256, 97259.\u003c/p\u003e\u003cp\u003eRequires GSM compatible 5G/4G LTE phone. After 50 GB high-speed data allotment is used, speeds will be reduced for the remainder of the plan period. During times of congestion, customers may experience reduced data speeds. Plans expire after 30 days. Plan only valid for calls, texts and data usage from the US and service may be unavailable in off-net areas. USA includes 50 states and Puerto Rico.\u003c/p\u003e\u003cp\u003eTexts to 900 numbers are not included. Purchase of international or roaming credit required to enable additional features (like international talk to countries not listed). For non-commercial, personal use only. Pre-paid services are non-refundable and non-transferable. Service may be suspended/terminated if used in violation of Acceptable Use Policy. SIM and assigned number expire after 60 days of non-use. All website purchases will be assessed a regulatory recovery fee of 5%. Plans, rates \u0026amp; services are subject to change without notice \u0026amp; are not available in all locations or for all phones.\u003c/p\u003e\u003cp\u003e\u003cbr /\u003e\u003c/p\u003e\u003cp\u003eFor More details, please refer to Lyca Mobile detailed \u003ca href=\"https://www.lycamobile.us/termscondition/\"\u003eTerms and Conditions.\u003c/a\u003e\u003c/p\u003e\u003cp\u003eAlso can check more Details for \u003ca href=\"https://cms-assets.ldsvcplatform.com/USA/s3fs-public/2025-09/International%20Calling%20Details%201.pdf?VersionId\u0026#61;TvsMpkyx5uHdpi9MqH2qW_Wq0gGVI5bo\"\u003e International Calling Countries.\u003c/a\u003e\u003c/p\u003e","productType":[{"id":"2312","productType":"30 Days Plan","productTypeCode":"30daysplan"},{"id":"2314","productType":"Family Plan","productTypeCode":"familyPlan"},{"id":"3535","productType":"Marketing","productTypeCode":"Marketing"}],"unlimitedData":null,"internationalRoamingAllowance":[{"internationalCallsGrpText":"Unlimited international talk \u0026 text to 100 countries*","internationalDestinations":[{"element":{"destinationName":"Morocco","ratesDestination":"MA","callingCountry":{"countryCode":"MA","countryName":" Morocco","region":"Africa","flag":{"metadata":null,"fullpath":"/_default_upload_bucket/Morocco1.png","id":"297"}}}},{"element":{"destinationName":"Namibia","ratesDestination":"NA","callingCountry":{"countryCode":"NA","countryName":"Namibia","region":"Africa","flag":{"metadata":null,"fullpath":"/_default_upload_bucket/Namibia.png","id":"134"}}}},{"element":{"destinationName":"South Africa","ratesDestination":"ZA","callingCountry":{"countryCode":"ZA","countryName":"South Africa","region":"Africa","flag":{"metadata":null,"fullpath":"/_default_upload_bucket/South-africa.png","id":"139"}}}},{"element":{"destinationName":"Swaziland","ratesDestination":"SZ","callingCountry":{"countryCode":"SZ","countryName":"Swaziland (Eswatini)","region":"Africa","flag":{"metadata":null,"fullpath":"/_default_upload_bucket/Swaziland.png","id":"141"}}}},{"element":{"destinationName":"China","ratesDestination":"CN","callingCountry":{"countryCode":"