aAllowance":null,"bonusDataAllowanceUnit":null,"bonusDataAllowanceDuration":null,"seoIndex":"Index","seoFollow":"Follow","scriptTag":"\n{\n  \"@context\": \"https://schema.org/\", \n  \"@type\": \"Product\", \n  \"name\": \"$33 High Data Plan\",\n  \"image\": \"https://pim-assets.ldsvcplatform.com/_default_upload_bucket/simusa_2.png\",\n  \"description\": \"Get $10 plan with 18GB high-speed data, unlimited talk \u0026 text, and roaming talk \u0026 text to Mexico and Canada. Activate instantly via eSIM.\",\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"name\": \"Lyca Mobile US\"\n  },\n  \"offers\": {\n    \"@type\": \"Offer\",\n    \"url\": \"https://www.lycamobile.us/en/plan/33-high-data-plan/\",\n    \"priceCurrency\": \"USD\",\n    \"price\": \"10\",\n    \"availability\": \"https://schema.org/InStock\",\n    \"itemCondition\": \"https://schema.org/NewCondition\"\n  },\n  \"aggregateRating\": {\n    \"@type\": \"AggregateRating\",\n    \"ratingValue\": \"4.5\",\n    \"bestRating\": \"5\",\n    \"worstRating\": \"3.6\",\n    \"ratingCount\": \"111\"\n  }\n}\n","boltOnType":null,"contractVisibility":null,"contractText":null,"captchaFlag":true,"familyPlanDetails":null,"familyPlanFeatures":"","familyPlanAvailable":null,"familyPlanImage":null,"customerType":[{"customerTypeCode":"ca","customerType":"New Customer"}],"bundleGroupDetails":[{"buddyBundleCode":null,"buddyBundlePrice":null,"buddyBundleAllowance":null,"buddyBundleName":null,"buddyOfferText":null,"buddyBundleHeading":null,"offeringId":null,"addonType":null,"recommendedPlans":null,"addonBundles":null,"bundleCode":"611035","existingCustomerBundleCode":null,"productValidity":30,"basePrice":33,"promotionalPricing":7.5,"promotionalPricingDuration":null,"productValidityUnit":"days","promotionalPricingDurationUnit":"days","promotionalText":null,"offerPricingBrief":null,"monthlyPricing":null,"monthlyPricingUnit":null,"longTermPlanProductValidity":null}],"longDescription":"\u003cul\u003e\u003cli class=\"plan-details-listitem\"\u003e18GB data at up to 5G speeds\u003c/li\u003e\u003cli\u003e\u003cspan class=\"pdata\"\u003eIncludes 10GB of High-Speed Hotspot Data\u003c/span\u003e\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003eUnlimited nationwide talk \u0026amp; text\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003eUnlimited international talk \u0026amp; text to 100 countries\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003e$5 International Roaming Credit\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003eUnlimited Talk and Text in Mexico and Canada \u003c/li\u003e\u003c/ul\u003e","shortDescription":"\u003cul\u003e\u003cli class=\"plan-details-listitem\"\u003e18GB data at up to 5G speeds\u003c/li\u003e\u003cli\u003eUnlimited nationwide talk \u0026amp; text\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003eUnlimited international talk \u0026amp; text to 100 countries\u003cbr /\u003e\u003c/li\u003e\u003c/ul\u003e","dialCode":null,"textShortCode":null,"allowRenew":"No","autoRenew":"Yes","productTermsAndCondition":"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\"font-size: 11.0pt; font-family: \u0026#039;Calibri\u0026#039;,sans-serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-IN; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;\"\u003e\u003ca href=\"https://cms-assets.ldsvcplatform.com/USA/s3fs-public/2025-12/33_High_Data_Plan%201.pdf?VersionId\u0026#61;y0p2Lj13nFV72of8AqIuHdAAcekTc8wD\" target=\"_blank\" rel=\"noopener\"\u003e﻿Broadband Facts\u003c/a\u003e\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cbr /\u003e\u003c/p\u003e\u003cp\u003eOffer available on new lines of service purchased at Lycamobile.com only. ENROLLMENT IN AUTO-RENEWAL REQUIRED to obtain discounted offer price. Discounted price available for initial 30-day plan and the number of renewals indicated, contingent on continued enrolment in auto-renewal (if auto-renewal is disabled or fails, discounted offer price will no longer apply for subsequent plan purchases). *Unlimited International calls are to first 10 dialled numbers per country.\u003c/p\u003e\u003cp\u003ePlan does not include unlimited calls to Morocco IAM and Wana destinations or calls to Israel numbers with prefix 97256, 97259.\u003c/p\u003e\u003cp\u003e\u003cbr /\u003e\u003c/p\u003e\u003cp\u003eRequires GSM compatible 5G/4G LTE phone. After high-speed data allotment is used, speeds will be reduced for the remainder of the plan period. During times of congestion, customers may experience reduced data speeds. Plans expire after 30 days.\u003c/p\u003e\u003cp\u003ePlan only valid for calls, texts and data usage from the US and service may be unavailable in off-net areas. USA includes 50 states and Puerto Rico. Texts to 900 numbers are not included. Purchase of international or roaming credit required to enable additional features (like international talk to countries not listed). For non-commercial, personal use only. Pre-paid services are non-refundable and non-transferable. Service may be suspended/terminated if used in violation of Acceptable Use Policy. SIM and assigned number expire after 60 days of non-use. All website purchases will be assessed a regulatory recovery fee of 5%. Plans, rates \u0026amp; services are subject to change without notice \u0026amp; are not available in all locations or for all phones.\u003c/p\u003e\u003cp\u003e\u003cbr /\u003e\u003c/p\u003e\u003cp\u003eFor More details, please refer to Lyca Mobile detailed \u003ca href=\"/termscondition\"\u003eTerms and Conditions.\u003c/a\u003e\u003c/p\u003e\u003cp\u003eAlso can check more Details for \u003ca href=\"https://cms-assets.ldsvcplatform.com/USA/s3fs-public/2025-09/International%20Calling%20Details%201.pdf?VersionId\u0026#61;TvsMpkyx5uHdpi9MqH2qW_Wq0gGVI5bo\"\u003e International Calling Countries.\u003c/a\u003e\u003c/p\u003e","productType":[{"id":"2312","productType":"30 Days Plan","productTypeCode":"30daysplan"}