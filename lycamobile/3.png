bestRating\": \"5\",\n    \"worstRating\": \"3.6\",\n    \"ratingCount\": \"111\"\n  }\n}\n","boltOnType":null,"contractVisibility":false,"contractText":null,"captchaFlag":true,"familyPlanDetails":null,"familyPlanFeatures":"","familyPlanAvailable":null,"familyPlanImage":null,"customerType":[{"customerTypeCode":"ca","customerType":"New Customer"}],"bundleGroupDetails":[{"buddyBundleCode":null,"buddyBundlePrice":null,"buddyBundleAllowance":null,"buddyBundleName":null,"buddyOfferText":null,"buddyBundleHeading":null,"offeringId":null,"addonType":null,"recommendedPlans":null,"addonBundles":null,"bundleCode":"2307","existingCustomerBundleCode":null,"productValidity":30,"basePrice":23,"promotionalPricing":5,"promotionalPricingDuration":null,"productValidityUnit":"days","promotionalPricingDurationUnit":"","promotionalText":null,"offerPricingBrief":null,"monthlyPricing":null,"monthlyPricingUnit":null,"longTermPlanProductValidity":null}],"longDescription":"\u003cul\u003e\u003cli\u003e8GB High-Speed Data\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003e8GB of High-Speed Hotspot Data\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003e$5 International Roaming Credit\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003eUnlimited National and International talk \u0026amp; text\u003cbr /\u003e\u003c/li\u003e\u003c/ul\u003e","shortDescription":"\u003cul\u003e\u003cli\u003e8GB High-Speed Data\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003e8GB of High-Speed Hotspot Data\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003e$5 International Roaming Credit\u003c/li\u003e\u003cli class=\"plan-details-listitem\"\u003eUnlimited National and International talk \u0026amp; text\u003c/li\u003e\u003c/ul\u003e","dialCode":null,"textShortCode":null,"allowRenew":"No","autoRenew":"Yes","productTermsAndCondition":"\u003cp\u003e\u003cspan class=\"ui-provider gr b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\"\u003e\u003cstrong\u003e\u003cspan style=\"font-size: 11.0pt; font-family: \u0026#039;Calibri\u0026#039;,sans-serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-IN; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;\"\u003e\u003ca href=\"https://cms-assets.ldsvcplatform.com/USA/s3fs-public/2025-12/23%20Unlimited%20Plan%20AFF.pdf?VersionId\u0026#61;DIejIiaWyrMjgInZPHc22Crt5_DVU5Qd\" target=\"_blank\" rel=\"noopener\"\u003e﻿Broadband Facts\u003c/a\u003e\u003c/span\u003e\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan class=\"ui-provider gr b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\"\u003e5G Data is available depending on location, supported on compatible Android/ iPhones running the latest software. IOS devices will work on 5G with IOS version 16.4 and above. Data speed slows down once you use up your plan’s data amount. \u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan class=\"ui-provider gr b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\"\u003eThe discounted price is applicable for first 30 days only. ENROLLMENT IN AUTO-RENEWAL REQUIRED to obtain discounted offer price.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan class=\"ui-provider gr b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\"\u003e*Unlimited International calls are to first 10 dialled numbers per country. Plan does not include unlimited calls to Morocco IAM and Wana destinations or calls to Israel numbers with prefix 97256, 97259.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cbr /\u003e\u003cbr /\u003ePlan expires after 30 days. All website purchases, including auto-recharges, will be assessed the Charge, which are currently set at a flat rate of five percent (5%). Only valid for calls, texts and data usage from the US. USA includes 50 states and Puerto Rico. Texts to 900 numbers are not included. Purchase of top-up credit required to enable additional features (like calls to other countries and international roaming). Offer of unlimited international calls to Lyca Mobile numbers only valid when both numbers are not roaming. No national roaming (voice, text and data not available in off-net areas – see \u003ca href=\"https://www.lycamobile.us/en/help/4g-coverage-and-services/\"\u003ecoverage map\u003c/a\u003e for details). Bonus credit expires after 30 days.\u003c/p\u003e\u003cp\u003e\u003cbr /\u003e\u003c/p\u003e\u003cp\u003eFor non-commercial, personal use only. pre-paid plans are non-refundable. Service may be suspended/terminated if used in violation of Acceptable Use Policy. SIM and assigned number expire after 60 days of non-use. Offer terms at time of plan activation apply, regardless of purchase date. Plans, rates \u0026amp; services are subject to change without notice \u0026amp; are not available in all locations or for all phones. LTE is a trademark of ETSI.\u003c/p\u003e\u003cp\u003e\u003cbr /\u003e\u003c/p\u003e\u003cp\u003eUnlimited International calls applicable to first 10 dialed numbers per country. The plan doesn’t include unlimited calls to Morocco IAM and Wana destinations. For More details Please refer to Lyca Mobile detailed \u003ca href=\"/termscondition\"\u003eTerms and Conditions\u003c/a\u003e.\u003c/p\u003e\u003cp\u003eAlso can check more Details for \u003ca href=\"https://cms-assets.ldsvcplatform.com/USA/s3fs-public/2025-09/International%20Calling%20Details%201.pdf?VersionId\u0026#61;TvsMpkyx5uHdpi9MqH2qW_Wq0gGVI5bo\"\u003e International Calling Countries.\u003c/a\u003e\u003c/p\u003e","productType":[{"id":"3535","productType":"Marketing","productTypeCode":"Marketing"}],"unlimitedData":null,"internationalRoamingAllowance":[{"internationalCallsGrpText":"Unlimited international talk \u0026text to 100 countries*","internationalDestinations":[{"element":{"destinationName":"Morocco","ratesDestination":"MA","callingCountry":{"countryCode":"MA","countryName":" Morocco","region":"