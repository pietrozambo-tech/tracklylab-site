  const campaignData = JSON.parse(sessionStorage.getItem('campaign_data') || '{}');
  let campaign_name, campaign_offer, campaign_type, is_campaign_join, locationIDs, showAllLocations, campaign_cta, join_cta_anchor;
  if(campaignData && campaignData.offer === "landing_page") {
     campaign_name = campaignData.name;
     campaign_offer = campaignData.offer;
     campaign_type = campaignData.type;
     is_campaign_join = campaignData.join;
     locationIDs = campaignData.locations;
     showAllLocations = campaignData.locationsAsDefault;
     campaign_cta = campaignData.cta;
     join_cta_anchor= campaignData.joinCtaAnchor;
  } else {
    sessionStorage.removeItem("packs_cta");
    campaign_name = "[US] Sales Storming";
    campaign_offer = "premier";
    campaign_type = "direct_join";
    is_campaign_join = "true";
    locationIDs = "";
    showAllLocations = "false";
    campaign_cta = "";
    join_cta_anchor= "";
  }
