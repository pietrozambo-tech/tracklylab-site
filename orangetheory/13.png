    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    visibility: visible !important;
    background: linear-gradient(90deg, #f2f2f2 0%, #e4e4e4 45%, #f2f2f2 90%) !important;
    background-size: 220% 100% !important;
    animation: otf-optimize-skeleton 1.2s ease-in-out infinite !important;
