<!-- Cargar la API de iPaper en la pÃ¡gina principal -->
<script src="https://cdn.ipaper.io/flipbooks/api/v3/latest.js"></script>

<script>
(function() {
 
  console.log('Inicializando el script de escucha dinÃ¡mica para folletos.eroski.es...');

  var trackedIframes = [];

  function getActiveGroups() {
    var activeGroups = [];
    if (window.OnetrustActiveGroups) {
      activeGroups = window.OnetrustActiveGroups.split(",").filter(function(element) {
        return !!element;
      });
    }
    return activeGroups;
  }

  function applyConsentToInstance(instance, activeConsentGroups) {
    var performanceCustomGroupId = 'C0002'; // IDs estÃ¡ndar de OneTrust
    var functionalCustomGroupId = 'C0003';  
    var advertisingCustomGroupId = 'C0004'; 

    var allowPerformanceCookies = activeConsentGroups.indexOf(performanceCustomGroupId) !== -1;
    var allowFunctionalCookies = activeConsentGroups.indexOf(functionalCustomGroupId) !== -1;
    var allowAdvertisingCookies = activeConsentGroups.indexOf(advertisingCustomGroupId) !== -1;

    // Log de envÃ­o de datos de consentimiento
    console.log('Enviando consentimiento a folletos.eroski.es:', {
      allowPerformanceCookies: allowPerformanceCookies,
      allowFunctionalCookies: allowFunctionalCookies,
      allowAdvertisingCookies: allowAdvertisingCookies
    });

    instance.consent.set({
      allowPerformanceCookies: allowPerformanceCookies,
      allowFunctionalCookies: allowFunctionalCookies,
      allowAdvertisingCookies: allowAdvertisingCookies
    });
  }

  // Bucle de escaneo continuo (cada 400ms)
  function scanAndSyncIframes() {
    if (typeof window.iPaperJsApi !== 'function') {
      setTimeout(scanAndSyncIframes, 100);
      return;
    }

    // Buscamos estrictamente los iframes de folletos.eroski.es
    var iframes = document.querySelectorAll('iframe[src*="folletos.eroski.es"]');
    var currentGroups = getActiveGroups();

    for (var i = 0; i < iframes.length; i++) {
      var iframe = iframes[i];
      
      if (!iframe.getAttribute('data-ipaper-sync-ready')) {
        try {
          iframe.setAttribute('data-ipaper-sync-ready', 'true');
          
          // Inicializamos la API vinculada a este iframe especÃ­fico de Eroski
          var instance = window.iPaperJsApi(iframe, 3);
          
          trackedIframes.push({
            element: iframe,
            instance: instance
          });

          // Log de folleto detectado
          console.log('[iPaper-Multi] Â¡Folleto de Eroski detectado en pantalla! URL:', iframe.src);
          
          // SincronizaciÃ³n instantÃ¡nea al abrirse el modal
          applyConsentToInstance(instance, currentGroups);

          // SincronizaciÃ³n de seguridad cuando el contenido interno termina de cargar
          iframe.addEventListener('load', function() {
            console.log('Evento "load" del iframe completado. Asegurando transmisiÃ³n de cookies.');
            applyConsentToInstance(instance, getActiveGroups());
          });

        } catch (error) {
          console.error('ðŸš¨ [iPaper-Multi] Error al conectar con el iframe de folletos.eroski.es:', error);
        }
      }
    }

    // Limpieza de memoria si el usuario cierra el modal del folleto
    var initialLength = trackedIframes.length;
    trackedIframes = trackedIframes.filter(function(item) {
      return document.body.contains(item.element);
    });

    // Log de cierre de folleto
    if (trackedIframes.length < initialLength) {
      console.log('[iPaper-Multi] Se ha cerrado un folleto de Eroski. CatÃ¡logos activos en pantalla:', trackedIframes.length);
    }

    setTimeout(scanAndSyncIframes, 400);
  }

  // Interceptor de OneTrust para cambios en tiempo real
  var hasWrapperInitialized = false;
  window.OptanonWrapper = function() {
    if (!hasWrapperInitialized) {
      console.log('OptanonWrapper activado por OneTrust.');
      
      if (window.OneTrust && typeof window.OneTrust.OnConsentChanged === 'function') {
        window.OneTrust.OnConsentChanged(function (event) {
          var detail = (event && event.detail) || [];
          
          // âš¡ Log de cambio manual en el banner de cookies
          console.log('âš¡ [iPaper-Multi] Cambio en el banner de cookies. Actualizando folletos abiertos: ' + trackedIframes.length);
          
          for (var j = 0; j < trackedIframes.length; j++) {
            applyConsentToInstance(trackedIframes[j].instance, detail);
          }
        });
      }
      hasWrapperInitialized = true;
    }
  };

  if (window.OnetrustActiveGroups && !hasWrapperInitialized) {
    window.OptanonWrapper();
  }

  // Lanzar el escÃ¡ner continuo
  scanAndSyncIframes();
})();
</script>

